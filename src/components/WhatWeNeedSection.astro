---
import { 
  Megaphone, 
  BookOpenCheck, 
  Users2, 
  Code2, 
  Palette, 
  Mail, 
  ArrowRight, 
  Sparkles, 
  Compass
} from 'lucide-astro';

const roles = [
  {
    title: 'Topluluk İletişimi & Duyuru Kolaylaştırıcısı',
    description: 'Nostr ağı ve açık protokoller üzerinde topluluk duyurularını organize etmek, yeni gelişmeleri paylaşmak ve ekosistem etkileşimini güçlendirmek.',
    icon: Megaphone,
    badge: 'İletişim & Duyuru',
    color: 'text-sky-500 bg-sky-50 dark:bg-sky-950/60 border-sky-200 dark:border-sky-800',
  },
  {
    title: 'İçerik Editörleri & Çevirmenler',
    description: 'NIP protokol standartlarının Türkçe çevirilerini yapmak, başlangıç rehberleri, bültenler ve teknik inceleme makaleleri hazırlamak.',
    icon: BookOpenCheck,
    badge: 'Dokümantasyon & Çeviri',
    color: 'text-emerald-500 bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800',
  },
  {
    title: 'Topluluk Liderleri & Buluşma Kolaylaştırıcıları',
    description: 'Farklı şehirlerde yerel Nostr buluşmaları, atölyeler ve çalışma grupları düzenlemek; yeni kullanıcılara açık anahtar ve istemci kurulumunda rehberlik etmek.',
    icon: Users2,
    badge: 'Topluluk & Organizasyon',
    color: 'text-purple-500 bg-purple-50 dark:bg-purple-950/60 border-purple-200 dark:border-purple-800',
  },
  {
    title: 'Geliştiriciler & Sistem Yöneticileri',
    description: 'Röle yönetimi, NIP geliştirmeleri, Nostr botları, web araçları ve açık kaynak kütüphanelerin inşasına katkı sağlamak.',
    icon: Code2,
    badge: 'Yazılım & Altyapı',
    color: 'text-amber-500 bg-amber-50 dark:bg-amber-950/60 border-amber-200 dark:border-amber-800',
  },
  {
    title: 'UI/UX & Görsel Tasarımcılar',
    description: 'Topluluk web platformunun arayüzünü geliştirmek, infografikler, açık kaynak eğitim kartları ve görsel kimlik materyalleri üretmek.',
    icon: Palette,
    badge: 'Tasarım & Deneyim',
    color: 'text-rose-500 bg-rose-50 dark:bg-rose-950/60 border-rose-200 dark:border-rose-800',
  },
];

const mailSubject = encodeURIComponent('[Nostr TR Katkı] Topluluk Rolü & Katkı Talebi');
const mailBody = encodeURIComponent(`Merhaba Nostr Türkiye Kolaylaştırıcıları,

Topluluğa aktif olarak katkıda bulunmak ve sorumluluk almak istiyorum.

1. İsim / Rumuz: 
2. Nostr Public Key (npub): 
3. İlgilendiğim Alan (İletişim, İçerik, Topluluk Liderliği, Geliştirici, Tasarım vb.): 
4. Kendimden Kısaca ve Neler Katabilirim?: 

Doakrasi ilkelerine ve topluluk manifestosuna bağlı kalmayı taahhüt ediyorum.

Teşekkürler.`);

const mailtoLink = `mailto:ekip@nostr.org.tr?subject=${mailSubject}&body=${mailBody}`;
---

<section class="space-y-8">
  
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-2 max-w-2xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-nostr-100 dark:bg-nostr-950 text-nostr-700 dark:text-nostr-300 border border-nostr-200 dark:border-nostr-800">
        <Sparkles class="w-3.5 h-3.5 text-nostr-500" />
        <span>Birlikte İnşa Ediyoruz</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Neye İhtiyacımız Var?
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Nostr Türkiye, hiyerarşiden uzak ve doakrasi (üretenin karar aldığı) prensibiyle çalışan açık bir topluluktur. Siz de yeteneğinize uygun alanda sorumluluk alarak ekosistemi büyütebilirsiniz.
      </p>
    </div>

    <a
      href={mailtoLink}
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-bold text-white bg-nostr-600 hover:bg-nostr-700 shadow-md shadow-nostr-500/20 transition-all active:scale-95 flex-shrink-0"
    >
      <Mail class="w-4 h-4" />
      <span>Aramıza Katılın</span>
      <ArrowRight class="w-4 h-4" />
    </a>
  </div>

  <!-- Open Roles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {roles.map((role) => {
      const Icon = role.icon;
      return (
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 hover:border-nostr-400 dark:hover:border-nostr-600 transition-all flex flex-col justify-between space-y-4 group">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <div class={`w-10 h-10 rounded-xl flex items-center justify-center border ${role.color} group-hover:scale-105 transition-transform`}>
                <Icon class="w-5 h-5" />
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                {role.badge}
              </span>
            </div>

            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
              {role.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {role.description}
            </p>
          </div>

          <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/60">
            <a
              href={mailtoLink}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-nostr-600 dark:text-nostr-400 hover:underline"
            >
              <span>Bu Alanda Katkı Sun</span>
              <ArrowRight class="w-3 h-3" />
            </a>
          </div>
        </div>
      );
    })}

    <!-- Wildcard / Free Contribution Card -->
    <div class="p-6 rounded-2xl bg-gradient-to-br from-nostr-600 to-indigo-700 text-white shadow-md flex flex-col justify-between space-y-4">
      <div class="space-y-3">
        <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white">
          <Compass class="w-5 h-5" />
        </div>
        <h3 class="text-base font-bold text-white">
          Kendi İnisiyatifinizi Başlatın
        </h3>
        <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
          Listelenen rollerin dışında yeni bir fikir, araç veya proje geliştirmek istiyorsanız; izne ihtiyacınız yok, inisiyatifi alıp başlayabilirsiniz!
        </p>
      </div>

      <div class="pt-2 border-t border-white/20">
        <a
          href={mailtoLink}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-white hover:underline"
        >
          <span>Fikrini Bizimle Paylaş</span>
          <ArrowRight class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>

</section>
