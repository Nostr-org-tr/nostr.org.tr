---
import { Quote, ExternalLink } from 'lucide-astro';

export interface Quotation {
  author: string;
  role: string;
  quoteTr: string;
  quoteEn: string;
  sourceUrl: string;
  sourceLabel: string;
}

export const quotations: Quotation[] = [
  {
    author: 'Edward Snowden',
    role: 'Gizlilik ve Özgür Yazılım Savunucusu',
    quoteTr: 'Nostr açık bir protokoldür. Bir platform kapalı bir silo ise, bir protokol nehirdir: kimse ona sahip olamaz ve herkes onda özgürce yüzebilir.',
    quoteEn: 'Nostr is an open protocol. If a platform is a silo, a protocol is a river: no one owns it, and everyone is free to swim.',
    sourceUrl: 'https://x.com/Snowden/status/1620789340199882752',
    sourceLabel: 'X / Nostr Duyurusu',
  },
  {
    author: 'Robert C. Martin (Uncle Bob)',
    role: 'Clean Code Yazarı & Yazılım Mimarı',
    quoteTr: 'Nostr\'ın sahibi yoktur ve kimse Nostr\'a sahip olamaz; çünkü o açık kaynaklı bir protokoldür. Hiç kimse bilginin akışını durdurmak için etrafına çit öremez.',
    quoteEn: 'No one owns Nostr, no one can own Nostr, it\'s an open-source protocol. No one can build a fence to stop the flow of information.',
    sourceUrl: 'https://www.youtube.com/watch?v=MaxXvcr181c',
    sourceLabel: 'Uncle Bob Sunumu',
  },
  {
    author: 'Gordon Brander',
    role: 'Dağıtık Sistemler Araştırmacısı / Subconscious',
    quoteTr: 'Nostr\'ın dağıtık protokoller için yepyeni ve temel bir mimari keşfettiğini iddia ediyorum: Ne federatif (Mastodon), ne de klasik P2P.',
    quoteEn: 'I want to claim that Nostr has discovered a new fundamental architecture for distributed protocols. Not federated, not P2P.',
    sourceUrl: 'https://newsletter.squishy.computer/p/natures-many-attempts-to-evolve-a',
    sourceLabel: 'Squishy Computer Bülteni',
  },
];
---

<section class="py-20 sm:py-28 bg-white dark:bg-[#0e1322] border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/80 text-purple-800 dark:text-purple-300 border border-purple-200/80 dark:border-purple-800/80 mb-3 shadow-xs">
        <Quote class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span class="font-mono uppercase tracking-wider">Perspektifler</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Fikir Önderleri Ne Diyor?
      </h2>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
        Ağ mimarları, güvenlik araştırmacıları ve mühendislerin Nostr protokolü üzerine değerlendirmeleri.
      </p>
    </div>

    <!-- Quotes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {quotations.map((item) => (
        <div class="flex flex-col justify-between p-7 sm:p-8 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400/80 dark:hover:border-purple-600/80 transition-all shadow-xs relative group">
          
          <div>
            <div class="text-4xl font-serif text-purple-400 dark:text-purple-500/60 mb-4 select-none leading-none">
              “
            </div>
            <blockquote class="text-sm sm:text-base font-medium text-slate-800 dark:text-slate-200 leading-relaxed mb-6">
              {item.quoteTr}
            </blockquote>
          </div>

          <div class="pt-5 border-t border-slate-200/80 dark:border-slate-800/80">
            <div class="font-bold text-sm text-slate-900 dark:text-white">
              {item.author}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 mb-2.5">
              {item.role}
            </div>
            <a 
              href={item.sourceUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-700 dark:text-purple-400 hover:text-purple-900 dark:hover:text-purple-200 transition-colors"
            >
              <span>{item.sourceLabel}</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
