---
import { Zap, Server, ShieldCheck, Wallet, ArrowUpRight } from 'lucide-astro';
import CopyButton from './CopyButton.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const lightningAddress = 'nostrorgtr@cake.cash';
const lightningUri = `lightning:${lightningAddress}`;
const lightningQrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(lightningUri)}`;

const moneroAddress = '498g3yjXBQfhA9WWgiyWroe3AS7ucd5vCQSqVz8UdR2fXo1BRxwC9v2jVBZBmuqufD4waeQXivbF7J3BtesG9o3PV1hbdpF';
const moneroUri = `monero:${moneroAddress}`;
const moneroQrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(moneroUri)}`;
---

<div class={`support-card relative overflow-hidden rounded-3xl border border-amber-200/80 dark:border-amber-900/60 bg-gradient-to-br from-amber-50/70 via-white to-amber-100/30 dark:from-slate-900 dark:via-amber-950/20 dark:to-slate-900 shadow-lg ${compact ? 'p-6 sm:p-7' : 'p-8 sm:p-10'}`}>
  
  <!-- Decorative background glow -->
  <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-amber-400/10 dark:bg-amber-500/10 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 space-y-6">
    
    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 shadow-sm">
          <Zap class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
          <span>Topluluk & Altyapı Desteği</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Sunucu ve Röle Giderlerimize Destek Olun
        </h3>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/80 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300">
          <Server class="w-3.5 h-3.5 text-amber-500" />
          <span>Bağımsız Barındırma</span>
        </span>
      </div>
    </div>

    <!-- Explanation paragraph -->
    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
      Nostr Türkiye topluluk rölesi (<span class="font-mono font-semibold text-slate-900 dark:text-white">relay.nostr.org.tr</span>), resmi Blossom medya sunucusu (<span class="font-mono font-semibold text-slate-900 dark:text-white">media.nostr.org.tr</span>) ve açık kaynak araçlarımız hiçbir şirket ya da reklam fonu olmaksızın, tamamen topluluk için bağımsız olarak barındırılmaktadır. Sunucu, depolama, bant genişliği ve işletim maliyetlerimize <span class="font-semibold text-slate-800 dark:text-slate-200">Lightning (LNURL)</span> veya gizlilik odaklı <span class="font-semibold text-slate-800 dark:text-slate-200">Monero (XMR)</span> ile destek olabilirsiniz.
    </p>

    <!-- Donation Method Switcher Tabs -->
    <div class="space-y-4">
      <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-2.5">
        <button
          type="button"
          data-support-tab="lightning"
          class="support-tab-btn active inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all border border-amber-300 dark:border-amber-700 bg-amber-400 text-amber-950 shadow-sm"
          aria-selected="true"
        >
          <Zap class="w-4 h-4 fill-current" />
          <span>Lightning Network</span>
        </button>

        <button
          type="button"
          data-support-tab="monero"
          class="support-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
          aria-selected="false"
        >
          <ShieldCheck class="w-4 h-4 text-orange-500" />
          <span>Monero (XMR)</span>
        </button>
      </div>

      <!-- Lightning Panel -->
      <div id="support-panel-lightning" class="support-panel grid grid-cols-1 md:grid-cols-12 gap-6 items-center pt-2">
        
        <!-- Address & Quick Actions (Left / Main) -->
        <div class="md:col-span-8 space-y-4">
          
          <!-- Lightning Address Pill -->
          <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-slate-950/80 border border-amber-200 dark:border-amber-800/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950 flex items-center justify-center text-amber-600 dark:text-amber-400 flex-shrink-0">
                <Zap class="w-5 h-5 fill-amber-500 text-amber-500" />
              </div>
              <div class="min-w-0">
                <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">Lightning Adresi (LNURL / LUD-16)</span>
                <span class="text-sm sm:text-base font-mono font-bold text-slate-900 dark:text-white truncate block">
                  {lightningAddress}
                </span>
              </div>
            </div>

            <div class="flex items-center gap-2 flex-shrink-0">
              <CopyButton text={lightningAddress} label="Adresi Kopyala" />
              
              <a
                href={lightningUri}
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-amber-950 bg-amber-400 hover:bg-amber-300 dark:bg-amber-400 dark:hover:bg-amber-300 shadow-sm transition-all active:scale-95"
                title="Lightning Cüzdanında Aç"
              >
                <Zap class="w-3.5 h-3.5 fill-current" />
                <span>Zap Gönder</span>
              </a>
            </div>
          </div>

          <!-- Suggested Satoshi Presets -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <span class="text-xs text-slate-500 dark:text-slate-400 mr-1">Örnek Katkı:</span>
            
            <a
              href={lightningUri}
              class="px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-white dark:bg-slate-800/80 hover:bg-amber-100 dark:hover:bg-amber-950/60 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors"
            >
              ⚡ 1.000 sats
            </a>

            <a
              href={lightningUri}
              class="px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-white dark:bg-slate-800/80 hover:bg-amber-100 dark:hover:bg-amber-950/60 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors"
            >
              ⚡ 5.000 sats
            </a>

            <a
              href={lightningUri}
              class="px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-white dark:bg-slate-800/80 hover:bg-amber-100 dark:hover:bg-amber-950/60 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors"
            >
              ⚡ 21.000 sats
            </a>

            <a
              href={lightningUri}
              class="px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-white dark:bg-slate-800/80 hover:bg-amber-100 dark:hover:bg-amber-950/60 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors"
            >
              ⚡ 50.000 sats
            </a>
          </div>

        </div>

        <!-- Lightning QR Code Scanner View (Right) -->
        <div class="md:col-span-4 flex flex-col items-center justify-center p-4 rounded-2xl bg-white dark:bg-slate-950/90 border border-amber-200/80 dark:border-slate-800 text-center space-y-2">
          <div class="p-2 rounded-xl bg-white shadow-inner border border-slate-100">
            <img
              src={lightningQrCodeUrl}
              alt={`Lightning QR - ${lightningAddress}`}
              class="w-28 h-28 object-contain rounded-lg"
              width="112"
              height="112"
              loading="lazy"
            />
          </div>
          <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
            Lightning cüzdanınızla QR kodu taratın
          </span>
        </div>

      </div>

      <!-- Monero Panel -->
      <div id="support-panel-monero" class="support-panel hidden grid-cols-1 md:grid-cols-12 gap-6 items-center pt-2">
        
        <!-- Address & Quick Actions (Left / Main) -->
        <div class="md:col-span-8 space-y-4">
          
          <!-- Monero Address Card -->
          <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-slate-950/80 border border-orange-200 dark:border-orange-900/60 shadow-sm space-y-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-orange-950/80 flex items-center justify-center text-orange-600 dark:text-orange-400 flex-shrink-0">
                  <ShieldCheck class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 block">Monero (XMR) Cüzdan Adresi</span>
                  <span class="text-xs font-semibold text-orange-600 dark:text-orange-400">Gizli, Güvenli & Sansürsüz</span>
                </div>
              </div>

              <div class="flex items-center gap-2 flex-shrink-0">
                <CopyButton text={moneroAddress} label="Adresi Kopyala" />
                
                <a
                  href={moneroUri}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 shadow-sm transition-all active:scale-95"
                  title="Monero Cüzdanında Aç"
                >
                  <Wallet class="w-3.5 h-3.5" />
                  <span>Cüzdanda Aç</span>
                  <ArrowUpRight class="w-3 h-3" />
                </a>
              </div>
            </div>

            <!-- Address String Block with Break -->
            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
              <p class="font-mono text-xs text-slate-800 dark:text-slate-200 break-all leading-relaxed select-all">
                {moneroAddress}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            <span>Monero işlemleri tam gizlilikle doğrudan blokzincir üzerinden gerçekleşir.</span>
          </div>

        </div>

        <!-- Monero QR Code Scanner View (Right) -->
        <div class="md:col-span-4 flex flex-col items-center justify-center p-4 rounded-2xl bg-white dark:bg-slate-950/90 border border-orange-200/80 dark:border-slate-800 text-center space-y-2">
          <div class="p-2 rounded-xl bg-white shadow-inner border border-slate-100">
            <img
              src={moneroQrCodeUrl}
              alt="Monero QR Code"
              class="w-28 h-28 object-contain rounded-lg"
              width="112"
              height="112"
              loading="lazy"
            />
          </div>
          <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
            Monero cüzdanınızla QR kodu taratın
          </span>
        </div>

      </div>

    </div>

  </div>
</div>

<script is:inline>
  const initSupportTabs = () => {
    const tabButtons = document.querySelectorAll('[data-support-tab]');
    const lightningPanel = document.getElementById('support-panel-lightning');
    const moneroPanel = document.getElementById('support-panel-monero');

    if (!tabButtons.length || !lightningPanel || !moneroPanel) return;

    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-has-support-listener') === 'true') return;
      btn.setAttribute('data-has-support-listener', 'true');

      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-support-tab');

        tabButtons.forEach((b) => {
          b.classList.remove('active', 'border-amber-300', 'dark:border-amber-700', 'bg-amber-400', 'text-amber-950', 'border-orange-400', 'dark:border-orange-700', 'bg-orange-500', 'text-white');
          b.classList.add('border-slate-200', 'dark:border-slate-700', 'bg-white/70', 'dark:bg-slate-800/80', 'text-slate-600', 'dark:text-slate-300');
          b.setAttribute('aria-selected', 'false');
        });

        if (tab === 'lightning') {
          btn.classList.add('active', 'border-amber-300', 'dark:border-amber-700', 'bg-amber-400', 'text-amber-950');
          btn.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-white/70', 'dark:bg-slate-800/80', 'text-slate-600', 'dark:text-slate-300');
          btn.setAttribute('aria-selected', 'true');

          lightningPanel.classList.remove('hidden');
          lightningPanel.classList.add('grid');
          moneroPanel.classList.add('hidden');
          moneroPanel.classList.remove('grid');
        } else if (tab === 'monero') {
          btn.classList.add('active', 'border-orange-400', 'dark:border-orange-700', 'bg-orange-500', 'text-white');
          btn.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-white/70', 'dark:bg-slate-800/80', 'text-slate-600', 'dark:text-slate-300');
          btn.setAttribute('aria-selected', 'true');

          moneroPanel.classList.remove('hidden');
          moneroPanel.classList.add('grid');
          lightningPanel.classList.add('hidden');
          lightningPanel.classList.remove('grid');
        }
      });
    });
  };

  initSupportTabs();
  document.addEventListener('astro:after-swap', initSupportTabs);
</script>
