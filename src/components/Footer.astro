---
import { Github, Mail, Zap, Radio, Database, ShieldCheck, Heart } from 'lucide-astro';

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!-- Hallmark · footer: Ft5 Statement colophon · genre: editorial -->
<footer class="mt-auto border-t border-slate-200/90 dark:border-slate-800/90 bg-[#f7f5ed] dark:bg-[#0d121f] text-slate-700 dark:text-slate-300 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 pb-10 border-b border-slate-200 dark:border-slate-800">
      
      <!-- Brand & Manifesto Colophon -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2.5">
          <img 
            src="/images/nostr-org-logo.jpeg" 
            alt="Nostr Türkiye" 
            class="w-8 h-8 rounded-xl object-cover shadow-sm ring-1 ring-slate-900/5 dark:ring-white/10" 
            width="32" 
            height="32" 
          />
          <div class="flex items-center gap-1.5 font-bold tracking-tight text-slate-900 dark:text-white text-base">
            <span>nostr</span>
            <span class="px-1.5 py-0.5 text-xs font-mono font-semibold rounded bg-tr-red/10 text-tr-red dark:bg-tr-red/20 dark:text-rose-400 border border-tr-red/20">
              .org.tr
            </span>
          </div>
        </div>

        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-sm leading-relaxed">
          {isEn
            ? "An independent, non-profit community initiative dedicated to free, decentralized, and cryptographic communication in Turkey."
            : "Şirketlerin ve kapalı algoritmaların değil; bireylerin kendi açık anahtarlarıyla özgürce iletişim kurduğu sansürsüz protokolün Türkiye platformu."}
        </p>

        <!-- Live Infrastructure Meta Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
          <a
            href="/roleler"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 text-slate-700 dark:text-slate-300 hover:border-nostr-400 dark:hover:border-nostr-500 transition-colors font-mono"
          >
            <Radio class="w-3.5 h-3.5 text-emerald-500 animate-pulse" />
            <span>relay.nostr.org.tr</span>
          </a>
          <a
            href="/roleler#blossom"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 text-slate-700 dark:text-slate-300 hover:border-nostr-400 dark:hover:border-nostr-500 transition-colors font-mono"
          >
            <Database class="w-3.5 h-3.5 text-nostr-500" />
            <span>blossom.nostr.org.tr</span>
          </a>
        </div>
      </div>

      <!-- Navigation Column 1: Ecosystem -->
      <div class="md:col-span-2 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-mono">
          {isEn ? "Ecosystem" : "Ekosistem"}
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href={isEn ? "/en/manifesto" : "/manifesto"} class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Manifesto
            </a>
          </li>
          <li>
            <a href="/topluluk" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Community" : "Topluluk"}
            </a>
          </li>
          <li>
            <a href="/roleler" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Relays & Blossom" : "Röleler & Blossom"}
            </a>
          </li>
          <li>
            <a href="/projeler" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Open Source Projects" : "Açık Kaynak Projeler"}
            </a>
          </li>
          <li>
            <a href="/takip-listeleri" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Follow Lists" : "Takip Listeleri"}
            </a>
          </li>
          <li>
            <a href="/araclar" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Nostr Tools" : "Protokol Araçları"}
            </a>
          </li>
        </ul>
      </div>

      <!-- Navigation Column 2: Guides & Education -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-mono">
          {isEn ? "Guides & Docs" : "Rehber & Dokümanlar"}
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href="/rehber" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Beginner's Guide" : "Başlangıç Rehberi"}
            </a>
          </li>
          <li>
            <a href="/gazeteciler-icin-nostr" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "For Journalists" : "Gazeteciler İçin Nostr"}
            </a>
          </li>
          <li>
            <a href="/sanatcilar-icin-nostr" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "For Artists & Creators" : "Sanatçılar İçin Nostr"}
            </a>
          </li>
          <li>
            <a href="/siyasetciler-icin-nostr" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "For Public Figures" : "Siyasetçiler İçin Nostr"}
            </a>
          </li>
          <li>
            <a href="/konusmalar" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              {isEn ? "Talks & Meetups" : "Konuşmalar & Sunumlar"}
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Blog & Notlar
            </a>
          </li>
        </ul>
      </div>

      <!-- Support & Contribution Column -->
      <div class="md:col-span-2 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-mono">
          {isEn ? "Support & Contact" : "Destek & İletişim"}
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a 
              href={isEn ? "/en/campaign" : "/kampanya"} 
              class="inline-flex items-center gap-1.5 text-tr-red dark:text-rose-400 font-semibold hover:underline"
            >
              <Heart class="w-3.5 h-3.5 fill-current" />
              <span>{isEn ? "Server Campaign" : "Sunucu Kampanyası"}</span>
            </a>
          </li>
          <li>
            <a 
              href="mailto:ekip@nostr.org.tr" 
              class="inline-flex items-center gap-1.5 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors"
            >
              <Mail class="w-3.5 h-3.5" />
              <span>ekip@nostr.org.tr</span>
            </a>
          </li>
          <li>
            <a 
              href="https://github.com/nostr-org-tr/nostr.org.tr" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a 
              href="lightning:nostrorgtr@cake.cash" 
              class="inline-flex items-center gap-1.5 text-amber-600 dark:text-amber-400 hover:underline font-mono text-xs"
              title="Lightning donation"
            >
              <Zap class="w-3.5 h-3.5 fill-current" />
              <span>nostrorgtr@cake.cash</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Colophon Bottom Statement -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-slate-400" />
        <span>© {currentYear} Nostr Türkiye Topluluğu. MIT License.</span>
      </div>
      <p class="text-slate-600 dark:text-slate-400">
        İletişim senin, kimlik senin, ağ senin.
      </p>
    </div>
  </div>
</footer>
