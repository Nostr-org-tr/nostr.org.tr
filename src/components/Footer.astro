---
import { Github, Mail, Zap } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Mission Statement -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <img src="/images/nostr-org-logo.jpeg" alt="Nostr Türkiye" class="w-7 h-7 rounded-lg object-cover" width="28" height="28" />
          <span class="font-bold text-slate-900 dark:text-white">Nostr Türkiye Topluluğu</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          Platformların ve algoritmaların değil; bireylerin özgür iradesinin ve açık protokollerin hakim olduğu bir internet için bağımsız, doakratik topluluk.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Açık Kaynak & Bağımsız
          </span>
          <span>•</span>
          <a 
            href="lightning:delirehberi@emre.xyz" 
            class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-400 hover:underline font-medium"
            title="Lightning ile sunucu masraflarına destek olun"
          >
            <Zap class="w-3.5 h-3.5 fill-current" />
            <span>Altyapı Desteği: delirehberi@emre.xyz</span>
          </a>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Topluluk & Ekosistem
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href="/manifesto" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Manifesto
            </a>
          </li>
          <li>
            <a href="/topluluk" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Topluluk & Ekip
            </a>
          </li>
          <li>
            <a href="/roleler" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Röleler (relay.nostr.org.tr)
            </a>
          </li>
          <li>
            <a href="/projeler" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Projeler & Araçlar
            </a>
          </li>
          <li>
            <a href="/takip-listeleri" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Takip Listeleri
            </a>
          </li>
          <li>
            <a href="/rehber" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Başlangıç Rehberi
            </a>
          </li>
          <li>
            <a href="/konusmalar" class="hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors">
              Konuşmalar & Sunumlar
            </a>
          </li>
        </ul>
      </div>

      <!-- Protocol & Contact -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          İletişim & Katkı
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a 
              href="mailto:ekip@nostr.org.tr" 
              class="inline-flex items-center gap-1.5 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors"
            >
              <Mail class="w-3.5 h-3.5" />
              <span>ekip@nostr.org.tr</span>
            </a>
          </li>
          <li>
            <a 
              href="https://github.com/nostr-org-tr/nostr.org.tr" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub Deposu</span>
            </a>
          </li>
          <li>
            <a 
              href="/en/manifesto" 
              class="inline-flex items-center gap-1.5 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors"
            >
              <span>English Manifesto</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 mt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {currentYear} Nostr Türkiye Topluluğu. Açık protokollere adanmıştır.</p>
      <p class="inline-flex items-center gap-1">
        <span>İletişim senin, kimlik senin, ağ senin.</span>
      </p>
    </div>
  </div>
</footer>
