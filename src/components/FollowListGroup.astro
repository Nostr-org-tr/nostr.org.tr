---
import type { FollowCategory } from '../data/followLists';
import CopyButton from './CopyButton.astro';
import { 
  GraduationCap, 
  Sparkles, 
  Code2, 
  Users, 
  Newspaper,
  Briefcase,
  Coffee,
  Bot,
  Globe,
  UserPlus, 
  BadgeCheck, 
  ExternalLink
} from 'lucide-astro';

interface Props {
  category: FollowCategory;
}

const { category } = Astro.props;

const categoryIcons: Record<string, any> = {
  GraduationCap,
  Sparkles,
  Code2,
  Users,
  Newspaper,
  Briefcase,
  Coffee,
  Bot,
  Globe,
};

const Icon = categoryIcons[category.icon] || Users;
const allNpubs = category.profiles.map(p => p.npub).join('\n');
const npubListJson = JSON.stringify(category.profiles.map(p => ({ name: p.name, npub: p.npub })));
---

<div class="follow-group-card p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
  
  <!-- Category Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 flex items-center justify-center flex-shrink-0">
        <Icon class="w-5 h-5" />
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
          {category.title}
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          {category.description} ({category.profiles.length} Profil)
        </p>
      </div>
    </div>

    <!-- Batch Actions -->
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <button
        type="button"
        class="follow-all-btn inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-nostr-600 hover:bg-nostr-700 shadow-sm transition-all active:scale-95 w-full sm:w-auto"
        data-profiles={npubListJson}
      >
        <UserPlus class="w-3.5 h-3.5" />
        <span class="btn-text">Tümünü Takip Et</span>
      </button>

      <CopyButton text={allNpubs} label="Npub'ları Kopyala" />
    </div>
  </div>

  <!-- Profiles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {category.profiles.map((profile) => (
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/60 dark:border-slate-800/80 flex flex-col justify-between space-y-3">
        <div>
          <!-- Name & NIP-05 -->
          <div class="flex items-start justify-between gap-2">
            <div>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">
                {profile.name}
              </h4>
              {profile.nip05 && (
                <div class="inline-flex items-center gap-1 text-[11px] font-mono text-nostr-600 dark:text-nostr-400">
                  <BadgeCheck class="w-3 h-3 flex-shrink-0" />
                  <span class="truncate">{profile.nip05}</span>
                </div>
              )}
            </div>
          </div>

          <!-- Bio -->
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mt-2 line-clamp-2">
            {profile.bio}
          </p>

          <!-- Tags -->
          {profile.tags && (
            <div class="flex flex-wrap gap-1 mt-2.5">
              {profile.tags.map((tag) => (
                <span class="px-1.5 py-0.5 text-[10px] rounded bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200/40 dark:border-slate-700/40">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Single Actions -->
        <div class="pt-2 border-t border-slate-200/40 dark:border-slate-800/40 flex items-center justify-between gap-2">
          <a
            href={`nostr:${profile.npub}`}
            class="text-[11px] font-semibold text-nostr-600 dark:text-nostr-400 hover:underline flex items-center gap-1"
            title="İstemcide Takip Et (nostr:)"
          >
            <span>Takip Et</span>
            <ExternalLink class="w-3 h-3 opacity-60" />
          </a>

          <CopyButton text={profile.npub} label="Npub Kopyala" />
        </div>
      </div>
    ))}
  </div>

</div>

<script is:inline>
  const setupFollowAllButtons = () => {
    document.querySelectorAll('.follow-all-btn').forEach((btn) => {
      if (btn.getAttribute('data-listener') === 'true') return;
      btn.setAttribute('data-listener', 'true');

      btn.addEventListener('click', async () => {
        const raw = btn.getAttribute('data-profiles');
        if (!raw) return;
        const profiles = JSON.parse(raw);
        const btnText = btn.querySelector('.btn-text');

        // Check if NIP-07 extension is available
        if (window.nostr && typeof window.nostr.getPublicKey === 'function') {
          try {
            if (btnText) btnText.textContent = 'Eklenti Aranıyor...';
            await window.nostr.getPublicKey();

            // Notify user of batch follow trigger
            if (btnText) btnText.textContent = 'İmzalanıyor...';
            
            // Generate follow tags
            const tags = profiles.map(p => ['p', p.npub, '', p.name]);

            // Create or append to follow list (kind 3)
            const eventTemplate = {
              kind: 3,
              created_at: Math.floor(Date.now() / 1000),
              tags: tags,
              content: '',
            };

            const signed = await window.nostr.signEvent(eventTemplate);

            // Publish to common relays
            const relays = ['wss://relay.damus.io', 'wss://nos.lol', 'wss://relay.primal.net'];
            relays.forEach(r => {
              try {
                const ws = new WebSocket(r);
                ws.onopen = () => {
                  ws.send(JSON.stringify(['EVENT', signed]));
                  setTimeout(() => { try { ws.close(); } catch(e){} }, 2000);
                };
              } catch(e){}
            });

            if (btnText) btnText.textContent = 'Tümü Takip Edildi! ✓';
            setTimeout(() => {
              if (btnText) btnText.textContent = 'Tümünü Takip Et';
            }, 3000);

          } catch (err) {
            console.error('Toplu takip hatası:', err);
            // Fallback: Copy all to clipboard
            const npubs = profiles.map(p => p.npub).join('\n');
            await navigator.clipboard.writeText(npubs);
            if (btnText) btnText.textContent = 'Npub\'lar Kopyalandı!';
            setTimeout(() => {
              if (btnText) btnText.textContent = 'Tümünü Takip Et';
            }, 2500);
          }
        } else {
          // If no extension, copy all npubs and advise user
          const npubs = profiles.map(p => p.npub).join('\n');
          try {
            await navigator.clipboard.writeText(npubs);
            if (btnText) btnText.textContent = 'Npub\'lar Kopyalandı!';
            setTimeout(() => {
              if (btnText) btnText.textContent = 'Tümünü Takip Et';
            }, 2500);
          } catch(e){}
        }
      });
    });
  };

  setupFollowAllButtons();
  document.addEventListener('astro:after-swap', setupFollowAllButtons);
</script>
