---
import type { RelayInfo } from '../data/relays';
import CopyButton from './CopyButton.astro';
import { Radio, ShieldCheck, Lock, ExternalLink, RefreshCw, Mail, Sparkles } from 'lucide-astro';

interface Props {
  relay: RelayInfo;
}

const { relay } = Astro.props;
---

<div 
  class="relay-card p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:border-nostr-300 dark:hover:border-nostr-700 transition-all flex flex-col justify-between"
  data-relay-url={relay.url}
  data-opening-soon={relay.openingSoon ? "true" : "false"}
>
  <div>
    <!-- Top Row: Name, Badges & Ping Status -->
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Radio class="w-5 h-5 text-nostr-500" />
            <span>{relay.name}</span>
          </h3>
          {relay.isOfficialCommunityRelay && (
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-tr-red/10 text-tr-red dark:bg-tr-red/20 dark:text-rose-400 border border-tr-red/20">
              <ShieldCheck class="w-3 h-3" />
              <span>Resmi Topluluk Rölesi</span>
            </span>
          )}
          {relay.openingSoon && (
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
              <Sparkles class="w-3 h-3" />
              <span>Çok Yakında Yayında</span>
            </span>
          )}
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Konum: <span class="text-slate-700 dark:text-slate-200 font-medium">{relay.location}</span> • Yazılım: <span class="font-mono">{relay.software}</span>
        </p>
      </div>

      <!-- Realtime Latency Badge -->
      <div class="latency-badge flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 self-start">
        <span class="status-dot w-2 h-2 rounded-full bg-slate-400 animate-pulse"></span>
        <span class="latency-text">{relay.openingSoon ? 'Yakında Aktif' : 'Test ediliyor...'}</span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
      {relay.description}
    </p>

    <!-- Relay Endpoint Copy Box -->
    <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800 mb-4 font-mono text-xs text-slate-700 dark:text-slate-300">
      <span class="truncate">{relay.url}</span>
      <CopyButton text={relay.url} label="Röle Adresini Kopyala" />
    </div>

    <!-- Policies & NIPs -->
    <div class="grid grid-cols-2 gap-2 text-xs mb-4">
      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Okuma İzni:</span>
        <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 mt-0.5">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Herkese Açık (Open Read)</span>
        </span>
      </div>
      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Yazma İzni:</span>
        {relay.writePolicy === 'whitelist' ? (
          <span class="font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1 mt-0.5">
            <Lock class="w-3.5 h-3.5" />
            <span>Topluluk Whitelist</span>
          </span>
        ) : (
          <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 mt-0.5">
            <ShieldCheck class="w-3.5 h-3.5" />
            <span>Açık (Open Write)</span>
          </span>
        )}
      </div>
    </div>

    <!-- Whitelist / Upcoming Notice for Official Relay -->
    {relay.writePolicy === 'whitelist' && (
      <div class="p-3.5 rounded-xl bg-nostr-50/70 dark:bg-nostr-950/40 border border-nostr-200/60 dark:border-nostr-800/50 text-xs text-slate-600 dark:text-slate-300 space-y-1.5 mb-4">
        <p class="font-semibold text-nostr-700 dark:text-nostr-300 flex items-center gap-1">
          <Mail class="w-3.5 h-3.5" />
          <span>Röleye Yazma İzni Başvurusu & Whitelist</span>
        </p>
        <p class="leading-relaxed">
          Spam ve bot kirliliğini önlemek adına röleye yazma izinleri whitelist ile tanımlanmaktadır. <code class="font-mono text-nostr-600 dark:text-nostr-400">npub</code> adresinizle <a href="mailto:ekip@nostr.org.tr?subject=Röle%20Yazma%20İzni%20Başvurusu" class="underline font-semibold hover:text-nostr-600">ekip@nostr.org.tr</a> üzerinden yazma izni talep edebilirsiniz.
        </p>
      </div>
    )}
  </div>

  <!-- Actions -->
  <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
    <button
      type="button"
      class="retest-btn inline-flex items-center gap-1 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
    >
      <RefreshCw class="w-3.5 h-3.5" />
      <span>Yeniden Test Et</span>
    </button>

    <a
      href={`nostr:${relay.url}`}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-nostr-600 dark:text-nostr-400 hover:text-nostr-700 dark:hover:text-nostr-300 transition-colors"
    >
      <span>İstemcide Ekle</span>
      <ExternalLink class="w-3.5 h-3.5" />
    </a>
  </div>
</div>

<script is:inline>
  const probeRelay = (card) => {
    const url = card.getAttribute('data-relay-url');
    const isOpeningSoon = card.getAttribute('data-opening-soon') === 'true';
    const badge = card.querySelector('.latency-badge');
    const dot = card.querySelector('.status-dot');
    const text = card.querySelector('.latency-text');

    if (!url || !badge || !dot || !text) return;

    dot.className = 'status-dot w-2 h-2 rounded-full bg-amber-400 animate-ping';
    text.textContent = 'Bağlanıyor...';

    const startTime = performance.now();
    let isFinished = false;

    try {
      const ws = new WebSocket(url);

      const timeout = setTimeout(() => {
        if (!isFinished) {
          isFinished = true;
          try { ws.close(); } catch(e){}
          if (isOpeningSoon) {
            dot.className = 'status-dot w-2 h-2 rounded-full bg-amber-400';
            text.textContent = 'Çok Yakında';
          } else {
            dot.className = 'status-dot w-2 h-2 rounded-full bg-rose-500';
            text.textContent = 'Zaman Aşımı';
          }
        }
      }, 4000);

      ws.onopen = () => {
        if (isFinished) return;
        isFinished = true;
        clearTimeout(timeout);
        const duration = Math.round(performance.now() - startTime);
        dot.className = 'status-dot w-2 h-2 rounded-full bg-emerald-500';
        text.textContent = `${duration} ms`;
        try { ws.close(); } catch(e){}
      };

      ws.onerror = () => {
        if (isFinished) return;
        isFinished = true;
        clearTimeout(timeout);
        if (isOpeningSoon) {
          dot.className = 'status-dot w-2 h-2 rounded-full bg-amber-400';
          text.textContent = 'Çok Yakında';
        } else {
          dot.className = 'status-dot w-2 h-2 rounded-full bg-rose-500';
          text.textContent = 'Bağlantı Hatası';
        }
      };
    } catch (err) {
      if (isOpeningSoon) {
        dot.className = 'status-dot w-2 h-2 rounded-full bg-amber-400';
        text.textContent = 'Çok Yakında';
      } else {
        dot.className = 'status-dot w-2 h-2 rounded-full bg-rose-500';
        text.textContent = 'Erişilemedi';
      }
    }
  };

  const setupRelayProbes = () => {
    document.querySelectorAll('.relay-card').forEach((card) => {
      probeRelay(card);
      const retestBtn = card.querySelector('.retest-btn');
      if (retestBtn) {
        retestBtn.addEventListener('click', () => probeRelay(card));
      }
    });
  };

  setupRelayProbes();
  document.addEventListener('astro:after-swap', setupRelayProbes);
</script>
