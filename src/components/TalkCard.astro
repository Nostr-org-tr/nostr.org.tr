---
import type { TalkItem } from '../data/talks';
import { Mic, Calendar, MapPin, ExternalLink, Presentation } from 'lucide-astro';

interface Props {
  talk: TalkItem;
}

const { talk } = Astro.props;
---

<!-- Hallmark · component: talk-card · genre: editorial -->
<div class="p-6 sm:p-8 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all">
  <div class="flex flex-col lg:flex-row gap-6 justify-between items-start">
    
    <div class="space-y-3 max-w-2xl">
      <!-- Badge & Event -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-50 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800">
          <Mic class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
          <span>{talk.event}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-slate-500 dark:text-slate-400">
          <Calendar class="w-3.5 h-3.5" />
          <span>{talk.date}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-slate-500 dark:text-slate-400">
          <MapPin class="w-3.5 h-3.5" />
          <span>{talk.location}</span>
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white leading-snug">
        {talk.title}
      </h3>

      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
        Konuşmacı: <span class="text-slate-900 dark:text-slate-100 font-semibold">{talk.speaker}</span>
      </p>

      <!-- Description -->
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        {talk.description}
      </p>

      <!-- Topics -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {talk.topics.map((topic) => (
          <span class="px-2.5 py-0.5 text-xs font-mono rounded-md bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
            {topic}
          </span>
        ))}
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 w-full lg:w-auto flex-shrink-0 pt-2 lg:pt-0">
      <a
        href={talk.slidesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-xs text-white bg-purple-700 hover:bg-purple-800 shadow-sm transition-all active:scale-[0.98]"
      >
        <Presentation class="w-4 h-4" />
        <span>Sunum Slaytlarını İncele</span>
        <ExternalLink class="w-3.5 h-3.5 opacity-80" />
      </a>
    </div>

  </div>
</div>
