---
import type { Member } from '../data/members';
import CopyButton from './CopyButton.astro';
import { BadgeCheck, Zap, Globe, Github, Sparkles, ExternalLink } from 'lucide-astro';

interface Props {
  member: Member;
}

const { member } = Astro.props;

const formatNpub = (npub: string) => {
  if (npub.length <= 16) return npub;
  return `${npub.slice(0, 10)}...${npub.slice(-6)}`;
};
---

<div 
  data-member-card
  data-npub={member.npub}
  class={`p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border transition-all duration-200 flex flex-col justify-between ${
    member.isFounder 
      ? 'border-nostr-300 dark:border-nostr-700 shadow-md shadow-nostr-500/5' 
      : 'border-slate-200 dark:border-slate-800 shadow-sm'
  }`}
>
  
  <div>
    <!-- Header: Avatar (Dynamic Nostr / Monogram) + Founder Badge -->
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="relative w-12 h-12 flex-shrink-0">
          <!-- Monogram Fallback -->
          <div class="member-monogram w-12 h-12 rounded-2xl bg-gradient-to-tr from-nostr-600 to-nostr-400 text-white font-bold text-lg flex items-center justify-center shadow-sm">
            {member.name.charAt(0)}
          </div>
          <!-- Dynamic Nostr Avatar Image -->
          <img 
            src="" 
            alt={member.name}
            class="member-avatar absolute inset-0 w-12 h-12 rounded-2xl object-cover hidden shadow-sm border border-slate-200/60 dark:border-slate-700/60 bg-slate-100 dark:bg-slate-800"
            loading="lazy"
          />
        </div>

        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="member-name">{member.name}</span>
          </h3>
          <p class="text-xs font-medium text-nostr-600 dark:text-nostr-400">
            {member.role}
          </p>
        </div>
      </div>

      {member.isFounder && (
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-tr-red/10 text-tr-red dark:bg-tr-red/20 dark:text-rose-400 border border-tr-red/20 flex-shrink-0">
          <Sparkles class="w-3 h-3" />
          <span>Kurucu</span>
        </span>
      )}
    </div>

    <!-- NIP-05 Identifier Container -->
    <div class="member-nip05-wrap mb-3">
      {member.nip05 ? (
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-mono font-medium text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60">
          <BadgeCheck class="w-3.5 h-3.5 text-nostr-500 flex-shrink-0" />
          <span class="member-nip05 truncate">{member.nip05}</span>
        </div>
      ) : (
        <div class="member-nip05-dyn hidden inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-mono font-medium text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60">
          <BadgeCheck class="w-3.5 h-3.5 text-nostr-500 flex-shrink-0" />
          <span class="member-nip05 truncate"></span>
        </div>
      )}
    </div>

    <!-- Bio -->
    <p class="member-bio text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
      {member.bio}
    </p>

    <!-- Npub & Lightning Badges -->
    <div class="mt-4 space-y-2">
      <!-- Npub Copy & Nostr Link -->
      <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800">
        <a 
          href={`nostr:${member.npub}`} 
          class="text-xs font-mono text-slate-600 dark:text-slate-400 hover:text-nostr-600 dark:hover:text-nostr-400 truncate flex items-center gap-1"
          title="İstemcide Aç (nostr:)"
        >
          <span class="font-bold text-nostr-500">npub:</span>
          <span>{formatNpub(member.npub)}</span>
          <ExternalLink class="w-3 h-3 opacity-60" />
        </a>
        <CopyButton text={member.npub} label="Npub Kopyala" />
      </div>

      <!-- Lightning Address Container -->
      <div class="member-lightning-wrap">
        {member.lightningAddress ? (
          <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-800/40">
            <div class="text-xs font-mono text-amber-800 dark:text-amber-300 flex items-center gap-1.5 truncate">
              <Zap class="w-3.5 h-3.5 text-amber-500 fill-amber-500 flex-shrink-0" />
              <span class="member-lud16 truncate">{member.lightningAddress}</span>
            </div>
            <CopyButton text={member.lightningAddress} label="Lightning Adresi Kopyala" />
          </div>
        ) : (
          <div class="member-lightning-dyn hidden flex items-center justify-between gap-2 p-2 rounded-xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-800/40">
            <div class="text-xs font-mono text-amber-800 dark:text-amber-300 flex items-center gap-1.5 truncate">
              <Zap class="w-3.5 h-3.5 text-amber-500 fill-amber-500 flex-shrink-0" />
              <span class="member-lud16 truncate"></span>
            </div>
            <CopyButton text="" label="Lightning Adresi Kopyala" className="member-lightning-copy-btn" />
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Social Links -->
  {member.socials && (
    <div class="mt-6 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
      {member.socials.website && (
        <a
          href={member.socials.website}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Web Sitesi"
        >
          <Globe class="w-4 h-4" />
        </a>
      )}
      {member.socials.github && (
        <a
          href={member.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="GitHub Profili"
        >
          <Github class="w-4 h-4" />
        </a>
      )}
    </div>
  )}

</div>
