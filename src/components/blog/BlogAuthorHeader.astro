---
import type { BlogPost } from '../../utils/nostrBlogFetcher';
import { NOSTR_CLIENT_BRIDGES } from '../../data/blogConfig';
import CopyButton from '../CopyButton.astro';
import { Zap, CheckCircle2, ExternalLink } from 'lucide-astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const author = post.author;
---

<div class="bg-slate-50 dark:bg-slate-900/60 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <!-- Author Info Left -->
    <div class="flex items-start gap-4">
      <div class="w-14 h-14 rounded-2xl bg-nostr-100 dark:bg-nostr-900/80 text-nostr-600 dark:text-nostr-300 flex items-center justify-center font-bold text-xl overflow-hidden border-2 border-nostr-200 dark:border-nostr-800 flex-shrink-0">
        {author.avatar ? (
          <img src={author.avatar} alt={author.name} class="w-full h-full object-cover" />
        ) : (
          author.name.charAt(0)
        )}
      </div>

      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            {author.name}
          </h3>
          {author.nip05 && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
              <CheckCircle2 class="w-3 h-3 text-emerald-500" />
              <span>{author.nip05}</span>
            </span>
          )}
        </div>

        {author.role && (
          <p class="text-xs text-nostr-600 dark:text-nostr-400 font-medium mt-0.5">
            {author.role}
          </p>
        )}

        {author.bio && (
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2 max-w-xl leading-relaxed">
            {author.bio}
          </p>
        )}

        <!-- Key & Lightning Badges -->
        <div class="flex flex-wrap items-center gap-2 mt-3">
          <!-- Npub copy -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-xs font-mono text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            <span class="text-[11px] opacity-70">npub:</span>
            <span>{author.npub.slice(0, 10)}...{author.npub.slice(-4)}</span>
            <CopyButton text={author.npub} label="Npub Kopyala" className="!p-1 !bg-transparent !border-0" />
          </div>

          <!-- Lightning Zap Address -->
          {author.lightningAddress && (
            <a
              href={`lightning:${author.lightningAddress}`}
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 text-xs font-medium hover:bg-amber-100 transition-colors"
              title="Lightning ile Zap Gönder"
            >
              <Zap class="w-3.5 h-3.5 text-amber-500 fill-amber-500" />
              <span>Zap Gönder ({author.lightningAddress})</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Nostr Native Bridge Buttons -->
    {post.naddr && (
      <div class="w-full sm:w-auto flex-shrink-0 pt-4 sm:pt-0 border-t sm:border-t-0 border-slate-200 dark:border-slate-800">
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">
          Nostr İstemcisinde Aç
        </div>
        <div class="flex flex-wrap sm:flex-col gap-1.5">
          {NOSTR_CLIENT_BRIDGES.slice(0, 3).map((client) => (
            <a
              href={client.urlTemplate(post.naddr)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-200 hover:text-nostr-600 dark:hover:text-nostr-400 hover:border-nostr-300 border border-slate-200 dark:border-slate-700 shadow-sm transition-all"
            >
              <span>{client.name}</span>
              <ExternalLink class="w-3 h-3 opacity-60" />
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
