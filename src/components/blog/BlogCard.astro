---
import type { BlogPost } from '../../utils/nostrBlogFetcher';
import { Calendar, Clock, ArrowRight, Tag } from 'lucide-astro';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(post.publishedAt * 1000));
---

{featured ? (
  <article class="group relative bg-white dark:bg-slate-900/90 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden grid md:grid-cols-12 gap-0 md:gap-8">
    <!-- Image Column -->
    <div class="md:col-span-6 lg:col-span-5 relative overflow-hidden bg-slate-100 dark:bg-slate-800 min-h-[260px] md:min-h-[360px]">
      <img
        src={post.image || '/og-image.png'}
        alt={post.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent md:hidden" />
      
      <!-- Featured Badge -->
      <div class="absolute top-4 left-4 z-10">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-nostr-500 text-white shadow-md">
          Öne Çıkan Yazı
        </span>
      </div>
    </div>

    <!-- Content Column -->
    <div class="md:col-span-6 lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <!-- Tags & Meta -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-md bg-nostr-50 dark:bg-nostr-950/60 text-nostr-700 dark:text-nostr-300 border border-nostr-200/60 dark:border-nostr-800/60">
              <Tag class="w-2.5 h-2.5 opacity-70" />
              #{tag.replace(/^#/, '')}
            </span>
          ))}
          <span class="text-xs text-slate-400 dark:text-slate-500">•</span>
          <span class="inline-flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
            <Clock class="w-3.5 h-3.5" />
            {post.readingTime}
          </span>
        </div>

        <!-- Title -->
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors line-clamp-2">
          <a href={`/blog/${post.naddr}`}>
            {post.title}
          </a>
        </h2>

        <!-- Summary -->
        <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed line-clamp-3">
          {post.summary}
        </p>
      </div>

      <!-- Footer: Author & Action -->
      <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-nostr-100 dark:bg-nostr-900/60 text-nostr-600 dark:text-nostr-300 flex items-center justify-center font-bold text-sm overflow-hidden border border-nostr-200 dark:border-nostr-800">
            {post.author.avatar ? (
              <img src={post.author.avatar} alt={post.author.name} class="w-full h-full object-cover" />
            ) : (
              post.author.name.charAt(0)
            )}
          </div>
          <div>
            <div class="font-semibold text-sm text-slate-900 dark:text-white leading-tight">
              {post.author.name}
            </div>
            <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              <Calendar class="w-3 h-3" />
              <span>{formattedDate}</span>
            </div>
          </div>
        </div>

        <a
          href={`/blog/${post.naddr}`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-nostr-600 hover:bg-nostr-700 text-white shadow-sm hover:shadow transition-all group-hover:translate-x-0.5"
          aria-label={`${post.title} yazısını oku`}
        >
          <span>Oku</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </article>
) : (
  <article class="group bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between overflow-hidden">
    <!-- Image Header -->
    <div class="relative aspect-[16/9] bg-slate-100 dark:bg-slate-800 overflow-hidden">
      <img
        src={post.image || '/og-image.png'}
        alt={post.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute bottom-2 left-2 flex items-center gap-1.5 px-2 py-1 rounded-md bg-black/60 backdrop-blur-sm text-[11px] text-white font-medium">
        <Clock class="w-3 h-3 text-nostr-300" />
        <span>{post.readingTime}</span>
      </div>
    </div>

    <!-- Body -->
    <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between">
      <div>
        <!-- Tags -->
        <div class="flex flex-wrap items-center gap-1.5 mb-2.5">
          {post.tags.slice(0, 2).map((tag) => (
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              #{tag.replace(/^#/, '')}
            </span>
          ))}
        </div>

        <!-- Title -->
        <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors line-clamp-2">
          <a href={`/blog/${post.naddr}`}>
            {post.title}
          </a>
        </h3>

        <!-- Summary -->
        <p class="mt-2 text-slate-600 dark:text-slate-400 text-xs sm:text-sm line-clamp-3 leading-relaxed">
          {post.summary}
        </p>
      </div>

      <!-- Author Footer -->
      <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-nostr-100 dark:bg-nostr-900/60 text-nostr-600 dark:text-nostr-300 flex items-center justify-center font-bold text-xs overflow-hidden">
            {post.author.avatar ? (
              <img src={post.author.avatar} alt={post.author.name} class="w-full h-full object-cover" />
            ) : (
              post.author.name.charAt(0)
            )}
          </div>
          <div>
            <div class="font-medium text-xs text-slate-900 dark:text-white leading-tight">
              {post.author.name}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              {formattedDate}
            </div>
          </div>
        </div>

        <a
          href={`/blog/${post.naddr}`}
          class="text-xs font-semibold text-nostr-600 dark:text-nostr-400 hover:text-nostr-700 dark:hover:text-nostr-300 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
        >
          <span>Oku</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </article>
)}
