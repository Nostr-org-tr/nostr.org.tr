---
import { 
  ScrollText, 
  Users, 
  Radio, 
  FolderGit2, 
  ListChecks, 
  BookOpen, 
  Mic, 
  Newspaper,
  Palette,
  Vote,
  Menu, 
  X,
  ChevronDown,
  Compass,
  Library,
  Languages,
  Feather,
  Wrench
} from 'lucide-astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
  isEn?: boolean;
}

const { currentPath = '/', isEn = false } = Astro.props;

// Grouped navigation structure
const singleNavs = [
  { href: '/manifesto', label: 'Manifesto', icon: ScrollText },
  { href: '/topluluk', label: 'Topluluk', icon: Users },
  { href: '/blog', label: 'Blog', icon: Feather },
];

const discoverItems = [
  { href: '/araclar', label: 'Araçlar', desc: 'NIP-19, NIP-05, eklenti & ağ testleri', icon: Wrench },
  { href: '/roleler', label: 'Röleler', desc: 'Röle listesi & bağlantılar', icon: Radio },
  { href: '/projeler', label: 'Projeler', desc: 'Açık kaynak araçlar & botlar', icon: FolderGit2 },
  { href: '/takip-listeleri', label: 'Takip Listeleri', desc: 'Kategorize edilmiş hesaplar', icon: ListChecks },
];

const resourceItems = [
  { href: '/rehber', label: 'Başlangıç Rehberi', desc: 'Nostr istemcileri & kurulum', icon: BookOpen },
  { href: '/gazeteciler-icin-nostr', label: 'Gazeteciler İçin', desc: 'Özgür & dayanıklı habercilik', icon: Newspaper },
  { href: '/sanatcilar-icin-nostr', label: 'Sanatçılar İçin', desc: 'Aracısız telif & eser sahipliği', icon: Palette },
  { href: '/siyasetciler-icin-nostr', label: 'Siyasetçiler İçin', desc: 'Kesintisiz iletişim & güvenlik', icon: Vote },
  { href: '/konusmalar', label: 'Konuşmalar & Sunumlar', desc: 'Etkinlik ve sunum kayıtları', icon: Mic },
];

const isDiscoverActive = discoverItems.some(i => currentPath === i.href || (i.href !== '/' && currentPath.startsWith(i.href)));
const isResourceActive = resourceItems.some(i => currentPath === i.href || (i.href !== '/' && currentPath.startsWith(i.href)));
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 dark:border-slate-800/80 glass-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a 
      href={isEn ? "/en/manifesto" : "/"} 
      class="flex items-center gap-2.5 group transition-transform active:scale-95 flex-shrink-0"
      aria-label="Nostr Türkiye Ana Sayfa"
    >
      <img 
        src="/images/nostr-org-logo.jpeg" 
        alt="Nostr Türkiye" 
        class="w-9 h-9 rounded-xl object-cover transition-transform group-hover:scale-105 shadow-sm"
        width="36"
        height="36"
      />
      <div class="flex items-center gap-1.5 font-bold tracking-tight text-slate-900 dark:text-white">
        <span class="text-base sm:text-lg">nostr</span>
        <span class="px-1.5 py-0.5 text-xs font-mono font-semibold rounded bg-tr-red/10 text-tr-red dark:bg-tr-red/20 dark:text-rose-400 border border-tr-red/20">
          .org.tr
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Ana Menü">
      
      <!-- Top-Level Single Links -->
      {singleNavs.map((item) => {
        const Icon = item.icon;
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              isActive
                ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
            }`}
          >
            <Icon class="w-4 h-4 opacity-80" />
            <span>{item.label}</span>
          </a>
        );
      })}

      <!-- Keşfet Dropdown (Röleler, Projeler, Listeler) -->
      <div class="relative nav-dropdown-container">
        <button
          type="button"
          class={`nav-dropdown-trigger flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            isDiscoverActive
              ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
              : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <Compass class="w-4 h-4 opacity-80" />
          <span>Keşfet</span>
          <ChevronDown class="w-3.5 h-3.5 opacity-60 transition-transform duration-200 trigger-chevron" />
        </button>

        <div class="nav-dropdown-menu hidden absolute left-0 top-full pt-2 w-64 z-50">
          <div class="p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl space-y-1 backdrop-blur">
            {discoverItems.map((subItem) => {
              const SubIcon = subItem.icon;
              const isSubActive = currentPath === subItem.href || (subItem.href !== '/' && currentPath.startsWith(subItem.href));
              return (
                <a
                  href={subItem.href}
                  class={`flex items-start gap-3 p-2.5 rounded-xl transition-all ${
                    isSubActive
                      ? 'bg-nostr-50 dark:bg-nostr-950/70 text-nostr-600 dark:text-nostr-400'
                      : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200'
                  }`}
                >
                  <div class={`p-1.5 rounded-lg ${isSubActive ? 'bg-nostr-100 dark:bg-nostr-900 text-nostr-600 dark:text-nostr-300' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400'}`}>
                    <SubIcon class="w-4 h-4" />
                  </div>
                  <div>
                    <span class="block text-sm font-semibold leading-tight">{subItem.label}</span>
                    <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{subItem.desc}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Kaynaklar Dropdown (Rehber, Konuşmalar) -->
      <div class="relative nav-dropdown-container">
        <button
          type="button"
          class={`nav-dropdown-trigger flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            isResourceActive
              ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
              : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <Library class="w-4 h-4 opacity-80" />
          <span>Kaynaklar</span>
          <ChevronDown class="w-3.5 h-3.5 opacity-60 transition-transform duration-200 trigger-chevron" />
        </button>

        <div class="nav-dropdown-menu hidden absolute left-0 top-full pt-2 w-64 z-50">
          <div class="p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl space-y-1 backdrop-blur">
            {resourceItems.map((subItem) => {
              const SubIcon = subItem.icon;
              const isSubActive = currentPath === subItem.href || (subItem.href !== '/' && currentPath.startsWith(subItem.href));
              return (
                <a
                  href={subItem.href}
                  class={`flex items-start gap-3 p-2.5 rounded-xl transition-all ${
                    isSubActive
                      ? 'bg-nostr-50 dark:bg-nostr-950/70 text-nostr-600 dark:text-nostr-400'
                      : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200'
                  }`}
                >
                  <div class={`p-1.5 rounded-lg ${isSubActive ? 'bg-nostr-100 dark:bg-nostr-900 text-nostr-600 dark:text-nostr-300' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400'}`}>
                    <SubIcon class="w-4 h-4" />
                  </div>
                  <div>
                    <span class="block text-sm font-semibold leading-tight">{subItem.label}</span>
                    <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{subItem.desc}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

    </nav>

    <!-- Utility Actions (Language, Theme, Mobile Toggle) -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      
      <!-- Language Switcher -->
      {isEn ? (
        <a
          href="/manifesto"
          title="Türkçe Versiyon"
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border border-slate-200 dark:border-slate-700"
        >
          <Languages class="w-3.5 h-3.5 text-tr-red" />
          <span>TR</span>
        </a>
      ) : (
        <a
          href="/en/manifesto"
          title="English Manifesto"
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border border-slate-200 dark:border-slate-700"
        >
          <Languages class="w-3.5 h-3.5 text-nostr-500" />
          <span>EN</span>
        </a>
      )}

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Menüyü Aç/Kapat"
        aria-expanded="false"
        class="md:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        <Menu class="w-5 h-5 block" id="menu-icon" />
        <X class="w-5 h-5 hidden" id="close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur px-4 pt-3 pb-5 space-y-4 shadow-xl max-h-[85vh] overflow-y-auto"
  >
    <!-- Standalone Links -->
    <div class="space-y-1">
      {singleNavs.map((item) => {
        const Icon = item.icon;
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${
              isActive
                ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
                : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            <Icon class="w-4 h-4 opacity-80" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>

    <!-- Keşfet Section -->
    <div class="space-y-1.5 pt-2 border-t border-slate-200/80 dark:border-slate-800">
      <div class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Keşfet & Ekosistem
      </div>
      {discoverItems.map((item) => {
        const Icon = item.icon;
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors ${
              isActive
                ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
                : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            <Icon class="w-4 h-4 opacity-80" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>

    <!-- Kaynaklar Section -->
    <div class="space-y-1.5 pt-2 border-t border-slate-200/80 dark:border-slate-800">
      <div class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Kaynaklar & Dokümanlar
      </div>
      {resourceItems.map((item) => {
        const Icon = item.icon;
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors ${
              isActive
                ? 'text-nostr-600 dark:text-nostr-400 bg-nostr-50 dark:bg-nostr-950/60 font-semibold'
                : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            <Icon class="w-4 h-4 opacity-80" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>

  </div>
</header>

<script is:inline>
  const setupNav = () => {
    // 1. Mobile Menu
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileBtn && mobileMenu && menuIcon && closeIcon) {
      mobileBtn.onclick = () => {
        const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
        mobileBtn.setAttribute('aria-expanded', !isExpanded);
        mobileMenu.classList.toggle('hidden');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };
    }

    // 2. Desktop Dropdowns
    const dropdownContainers = document.querySelectorAll('.nav-dropdown-container');

    dropdownContainers.forEach((container) => {
      const trigger = container.querySelector('.nav-dropdown-trigger');
      const menu = container.querySelector('.nav-dropdown-menu');
      const chevron = container.querySelector('.trigger-chevron');
      if (!trigger || !menu) return;

      let timeoutId = null;

      const openDropdown = () => {
        if (timeoutId) clearTimeout(timeoutId);
        // Close others
        dropdownContainers.forEach((other) => {
          if (other !== container) {
            other.querySelector('.nav-dropdown-menu')?.classList.add('hidden');
            other.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
            other.querySelector('.trigger-chevron')?.classList.remove('rotate-180');
          }
        });
        menu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
      };

      const closeDropdown = () => {
        timeoutId = setTimeout(() => {
          menu.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.classList.remove('rotate-180');
        }, 150);
      };

      // Hover triggers
      container.addEventListener('mouseenter', openDropdown);
      container.addEventListener('mouseleave', closeDropdown);

      // Click toggle
      trigger.onclick = (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');
        if (isOpen) {
          closeDropdown();
        } else {
          openDropdown();
        }
      };
    });

    // Close dropdowns on outside click or ESC
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-dropdown-container')) {
        dropdownContainers.forEach((container) => {
          container.querySelector('.nav-dropdown-menu')?.classList.add('hidden');
          container.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          container.querySelector('.trigger-chevron')?.classList.remove('rotate-180');
        });
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdownContainers.forEach((container) => {
          container.querySelector('.nav-dropdown-menu')?.classList.add('hidden');
          container.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          container.querySelector('.trigger-chevron')?.classList.remove('rotate-180');
        });
      }
    });
  };

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
