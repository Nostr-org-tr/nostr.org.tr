---
import Layout from '../../layouts/Layout.astro';
import { fetchBlogPosts, type BlogPost } from '../../utils/nostrBlogFetcher';
import BlogAuthorHeader from '../../components/blog/BlogAuthorHeader.astro';
import BlogComments from '../../components/blog/BlogComments.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import CopyButton from '../../components/CopyButton.astro';
import { 
  Calendar, 
  Clock, 
  ArrowLeft, 
  Tag, 
  MessageSquare
} from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await fetchBlogPosts();
  const paths: Array<{ params: { slug: string }; props: { post: BlogPost } }> = [];

  for (const post of posts) {
    // 1. Human-readable slug path (e.g. /blog/nostr-nedir)
    paths.push({
      params: { slug: post.slug },
      props: { post },
    });

    // 2. Canonical NIP-19 naddr path (e.g. /blog/naddr1qq...)
    if (post.naddr && post.naddr !== post.slug) {
      paths.push({
        params: { slug: post.naddr },
        props: { post },
      });
    }
  }

  return paths;
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(post.publishedAt * 1000));

const isoPublishedTime = new Date(post.publishedAt * 1000).toISOString();

const breadcrumbItems = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: post.title, path: `/blog/${post.slug}` },
];

const currentUrl = `https://nostr.org.tr/blog/${post.slug}`;
---

<Layout
  title={`${post.title} - Nostr Türkiye Blog`}
  description={post.summary}
  ogImage={post.image || '/og-image.png'}
  ogType="article"
  publishedTime={isoPublishedTime}
>
  <ArticleSchema
    title={post.title}
    description={post.summary}
    path={`/blog/${post.slug}`}
    datePublished={isoPublishedTime}
    slot="head"
  />
  <BreadcrumbSchema items={breadcrumbItems} slot="head" />

  <article class="relative overflow-hidden pt-8 pb-20 sm:pt-12 sm:pb-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Navigation -->
      <div class="mb-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-nostr-600 dark:hover:text-nostr-400 transition-colors group"
        >
          <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          <span>Tüm Blog Yazılarına Dön</span>
        </a>
      </div>

      <!-- Article Header -->
      <header class="space-y-6 pb-8 border-b border-slate-200/80 dark:border-slate-800">
        <!-- Tags & Meta -->
        <div class="flex flex-wrap items-center gap-2">
          {post.tags.map((tag) => (
            <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-lg bg-nostr-50 dark:bg-nostr-950/60 text-nostr-700 dark:text-nostr-300 border border-nostr-200/70 dark:border-nostr-800/70">
              <Tag class="w-3 h-3 opacity-70" />
              #{tag.replace(/^#/, '')}
            </span>
          ))}
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span class="inline-flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
            <Clock class="w-3.5 h-3.5" />
            {post.readingTime} okuma
          </span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span class="inline-flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
            <Calendar class="w-3.5 h-3.5" />
            <time datetime={isoPublishedTime}>{formattedDate}</time>
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
          {post.title}
        </h1>

        <!-- Summary -->
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          {post.summary}
        </p>

        <!-- Quick Author Bar -->
        <div class="flex items-center justify-between pt-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-nostr-100 dark:bg-nostr-900/60 text-nostr-600 dark:text-nostr-300 flex items-center justify-center font-bold text-sm overflow-hidden border border-nostr-200 dark:border-nostr-800">
              {post.author.avatar ? (
                <img src={post.author.avatar} alt={post.author.name} class="w-full h-full object-cover" />
              ) : (
                post.author.name.charAt(0)
              )}
            </div>
            <div>
              <div class="font-bold text-sm text-slate-900 dark:text-white">
                {post.author.name}
              </div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                {post.author.role || post.author.nip05 || 'Topluluk Yazarı'}
              </div>
            </div>
          </div>

          <!-- Share / Jump to Comments -->
          <div class="flex items-center gap-2">
            <a
              href="#comments"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            >
              <MessageSquare class="w-3.5 h-3.5 text-nostr-500" />
              <span>Yorumlar</span>
            </a>
            <CopyButton text={currentUrl} label="Bağlantıyı Kopyala" showText={false} />
          </div>
        </div>
      </header>

      <!-- Featured Image (if exists) -->
      {post.image && (
        <div class="my-8 rounded-3xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-800 shadow-md">
          <img
            src={post.image}
            alt={post.title}
            class="w-full max-h-[480px] object-cover"
            onerror="this.style.display='none'"
          />
        </div>
      )}

      <!-- Main Article Typography Content -->
      <div 
        class="prose prose-slate dark:prose-invert lg:prose-lg max-w-none my-10 
               prose-headings:font-bold prose-headings:tracking-tight 
               prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4
               prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
               prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300
               prose-a:text-nostr-600 dark:prose-a:text-nostr-400 prose-a:no-underline hover:prose-a:underline
               prose-blockquote:border-l-4 prose-blockquote:border-nostr-500 prose-blockquote:bg-nostr-50/50 dark:prose-blockquote:bg-nostr-950/30 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-xl
               prose-code:text-nostr-700 dark:prose-code:text-nostr-300 prose-code:bg-slate-100 dark:prose-code:bg-slate-800/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
               prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-pre:rounded-2xl"
        set:html={post.html}
      />

      <!-- Author Bio & Support Box -->
      <div class="my-12">
        <BlogAuthorHeader post={post} />
      </div>

      <!-- Live NIP-22 Comments Section -->
      <BlogComments
        eventId={post.id}
        authorPubkey={post.pubkey}
        dTag={post.dTag}
        naddr={post.naddr}
      />

    </div>
  </article>
</Layout>
