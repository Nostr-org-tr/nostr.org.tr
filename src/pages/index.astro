---
import Layout from '../layouts/Layout.astro';
import HeroGraphCanvas from '../components/HeroGraphCanvas.astro';
import RelayPingCard from '../components/RelayPingCard.astro';
import BlossomPingCard from '../components/BlossomPingCard.astro';
import ServerSupportCard from '../components/ServerSupportCard.astro';
import WhatWeNeedSection from '../components/WhatWeNeedSection.astro';
import { communityRelay } from '../data/relays';
import { communityBlossomServer } from '../data/blossom';
import { talks } from '../data/talks';
import { 
  ScrollText, 
  Users, 
  Radio, 
  FolderGit2, 
  ListChecks, 
  BookOpen, 
  ArrowRight, 
  Zap, 
  ShieldCheck, 
  Key, 
  Network,
  Presentation,
  Terminal
} from 'lucide-astro';

import OrganizationSchema from '../components/seo/OrganizationSchema.astro';

const latestTalk = talks[0];
---

<!-- Hallmark · genre: editorial · macrostructure: Marquee Hero · design-system: design.md · designed-as-app -->
<Layout title="Nostr Türkiye Topluluğu - Özgür, Açık ve Sorumlu İletişimin Geleceği">
  <OrganizationSchema slot="head" />
  
  <!-- Hero Section: Editorial Marquee with Interactive Protocol Graph -->
  <section class="relative overflow-hidden py-20 sm:py-32 border-b border-slate-200/90 dark:border-slate-800/90 bg-[#faf9f5] dark:bg-[#0b0f19] min-h-[520px] flex items-center">
    <!-- Interactive Background Graph -->
    <HeroGraphCanvas />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pointer-events-none">
      
      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/80 text-purple-900 dark:text-purple-200 border border-purple-200/80 dark:border-purple-800/80 mb-8 shadow-xs pointer-events-auto backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-tr-red animate-pulse"></span>
        <span class="font-mono uppercase tracking-wider">nostr.org.tr</span>
        <span class="text-slate-400 dark:text-slate-600">/</span>
        <span>Türkiye Nostr Topluluğu</span>
      </div>

      <!-- Main Headline: Editorial Roman Display -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-4xl leading-[1.1] mb-6">
        İletişim senin, <br />
        kimlik senin, <br />
        <span class="nostr-gradient-text">ağ senin.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Merkezi şirket sunucularının ve algoritmik filtrelerin ötesinde; kriptografik anahtarlarla çalışan, sansürsüz ve açık iletişim protokolünün Türkiye platformu.
      </p>

      <!-- CTA Action Button Bar -->
      <div class="mt-10 flex flex-wrap items-center gap-3.5 pointer-events-auto">
        <a 
          href="/rehber" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-purple-700 hover:bg-purple-800 active:scale-[0.98] shadow-sm transition-all focus-visible:outline-2 focus-visible:outline-purple-500"
        >
          <span>Nostr'a Başla</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <a 
          href="/manifesto" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-100 bg-white dark:bg-slate-800/90 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-300/80 dark:border-slate-700 shadow-xs transition-all active:scale-[0.98]"
        >
          <ScrollText class="w-4 h-4 text-purple-600 dark:text-purple-400" />
          <span>Topluluk Manifestosu</span>
        </a>

        <a 
          href="/takip-listeleri" 
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          <ListChecks class="w-4 h-4" />
          <span>Takip Listeleri</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Core Pillars Section: 4-Column Bento Architecture -->
  <section class="py-20 bg-white dark:bg-[#0e1322] border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-2 font-semibold">
          Protokol Temelleri
        </p>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Neden Nostr?
        </h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Nostr bir şirket veya kapalı uygulama değil; e-posta gibi evrensel, hafif ve merkeziyetsiz bir açık standarttır.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Pillar 1 -->
        <div class="p-7 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400/80 dark:hover:border-purple-600/80 transition-all">
          <div class="w-11 h-11 rounded-xl bg-purple-100 dark:bg-purple-950/80 flex items-center justify-center text-purple-700 dark:text-purple-300 mb-5">
            <Key class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2.5">Kimlik & Anahtar Egemenliği</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Hesabınız şirket sunucularındaki bir kayıt değil, elinizdeki açık/gizli anahtarlardır. Kimse kimliğinizi silemez veya sansürleyemez.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="p-7 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-amber-400/80 dark:hover:border-amber-600/80 transition-all">
          <div class="w-11 h-11 rounded-xl bg-amber-100 dark:bg-amber-950/80 flex items-center justify-center text-amber-700 dark:text-amber-300 mb-5">
            <Zap class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2.5">Lightning & Mikro Ödemeler</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Beğeni ve etkileşim yerine gerçek mikro-değer transferi (Zap). İçerik üreticisine aracısız, anlık ve doğrudan destek.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="p-7 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-rose-400/80 dark:hover:border-rose-600/80 transition-all">
          <div class="w-11 h-11 rounded-xl bg-rose-100 dark:bg-rose-950/80 flex items-center justify-center text-rose-700 dark:text-rose-300 mb-5">
            <Network class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2.5">Dağıtık Röle Ağı</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Tek bir sunucuya mahkum değilsiniz. Dilediğiniz kadar röleye bağlanabilir veya dakikalar içinde kendi bağımsız rölenizi kurabilirsiniz.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="p-7 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-emerald-400/80 dark:hover:border-emerald-600/80 transition-all">
          <div class="w-11 h-11 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 flex items-center justify-center text-emerald-700 dark:text-emerald-300 mb-5">
            <ShieldCheck class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2.5">Doakrasi & Açık Standart</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Merkezi otorite yok. Kod yazan, sunucu barındıran, dokümantasyon çeviren ve üreten herkes topluluğun doğal bileşenidir.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Official Infrastructure Showcase (Relay + Blossom Media Server) -->
  <section class="py-20 bg-[#faf9f5] dark:bg-[#0b0f19] border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-2 font-semibold">
            Canlı Ağ Altyapısı
          </p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-3">
            <Radio class="w-6 h-6 text-purple-600 dark:text-purple-400" />
            <span>Türkiye Resmi Topluluk Altyapısı</span>
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-2xl">
            Topluluğumuz için bağımsız olarak barındırılan resmi iletişim rölesi ve merkeziyetsiz Blossom medya depolama sunucusu.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/roleler"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 hover:bg-purple-100 dark:hover:bg-purple-900 transition-colors"
          >
            <span>Tüm Altyapıyı Gör</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <RelayPingCard relay={communityRelay} />
        <BlossomPingCard server={communityBlossomServer} showMirrorList={false} />
      </div>

    </div>
  </section>

  <!-- Server Costs & Lightning Support Section -->
  <section class="py-20 bg-white dark:bg-[#0e1322] border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServerSupportCard />
    </div>
  </section>

  <!-- What We Need / Open Community Roles Section -->
  <section class="py-20 bg-[#faf9f5] dark:bg-[#0b0f19] border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <WhatWeNeedSection />
    </div>
  </section>

  <!-- Quick Ecosystem Directory Bento -->
  <section class="py-20 bg-white dark:bg-[#0e1322] border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-2 font-semibold">
          Navigasyon
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Topluluk Alanları ve Rehberler
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
          Nostr ekosistemini keşfetmek, araçları kullanmak ve topluluğa katılmak için bölümlere göz atın.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <a href="/topluluk" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <Users class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Topluluk & Ekip
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Kurucular, topluluk üyeleri ve çalışma gruplarına katılım kılavuzu.
          </p>
        </a>

        <a href="/projeler" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <FolderGit2 class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Projeler & Araçlar
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            rehber.dev kimlik servisi, x2nostr göç aracı ve yerli açık kaynak yazılımlar.
          </p>
        </a>

        <a href="/takip-listeleri" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <ListChecks class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Takip Listeleri
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Geliştiriciler, araştırmacılar, sanatçılar ve Türkçe yayın yapan profiller.
          </p>
        </a>

        <a href="/rehber" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <BookOpen class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Başlangıç Rehberi
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            İstemci kurulumu, anahtar yönetimi ve Lightning cüzdan entegrasyonu.
          </p>
        </a>

        <a href="/araclar" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <Terminal class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Protokol Araçları
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            NIP-19 çevirici, NIP-05 doğrulayıcı, anahtar üretici ve röle test araçları.
          </p>
        </a>

        <a href="/manifesto" class="group p-6 rounded-2xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 transition-all shadow-2xs hover:shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 group-hover:scale-105 transition-transform">
              <ScrollText class="w-5 h-5" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Topluluk Manifestosu
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Özgür, açık ve sorumlu iletişimin 5 temel ilkesi ve etik kuralları.
          </p>
        </a>

      </div>
    </div>
  </section>

  <!-- Featured Presentation Banner -->
  {latestTalk && (
    <section class="py-14 bg-slate-950 text-white border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1.5 max-w-2xl">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/30">
            <Presentation class="w-3.5 h-3.5" />
            <span>Öne Çıkan Sunum • {latestTalk.event}</span>
          </span>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight">
            {latestTalk.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-400">
            Konuşmacı: {latestTalk.speaker} • {latestTalk.location}
          </p>
        </div>

        <a
          href={latestTalk.slidesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-xs text-slate-900 bg-white hover:bg-slate-100 transition-all flex-shrink-0 active:scale-[0.98]"
        >
          <span>Slaytları Görüntüle</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </section>
  )}

</Layout>
