---
import Layout from '../layouts/Layout.astro';
import RelayPingCard from '../components/RelayPingCard.astro';
import { communityRelay } from '../data/relays';
import { talks } from '../data/talks';
import { 
  ScrollText, 
  Users, 
  Radio, 
  FolderGit2, 
  ListChecks, 
  BookOpen, 
  Mic, 
  ArrowRight, 
  Zap, 
  ShieldCheck, 
  Key, 
  Network,
  Presentation
} from 'lucide-astro';

import OrganizationSchema from '../components/seo/OrganizationSchema.astro';

const latestTalk = talks[0];
---

<Layout title="Nostr Türkiye Topluluğu - Özgür, Açık ve Sorumlu İletişimin Geleceği">
  <OrganizationSchema slot="head" />
  
  <!-- Hero Section (Clean & Slogan-Free Header Integration) -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-white via-slate-50 to-slate-100/50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-nostr-100 text-nostr-700 dark:bg-nostr-950/80 dark:text-nostr-300 border border-nostr-200 dark:border-nostr-800 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-tr-red animate-pulse"></span>
        <span>Türkiye Nostr Topluluğu</span>
        <span class="text-slate-400 dark:text-slate-600">|</span>
        <span class="text-slate-600 dark:text-slate-400">Özgür İletişim Protokolü</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-4xl leading-[1.15]">
        İletişim senin, <br />
        kimlik senin, <br />
        <span class="nostr-gradient-text">ağ senin.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Sosyal medya şirketlerinin ve kapalı algoritmaların değil, bireylerin kendi açık anahtarlarıyla (public key) özgürce iletişim kurduğu sansürsüz protokolün Türkiye merkezi.
      </p>

      <!-- CTA Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a 
          href="/rehber" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-nostr-600 hover:bg-nostr-700 shadow-md shadow-nostr-500/20 hover:shadow-lg transition-all active:scale-98"
        >
          <span>Nostr'a Başla</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <a 
          href="/manifesto" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 shadow-sm transition-all"
        >
          <ScrollText class="w-4 h-4 text-nostr-500" />
          <span>Topluluk Manifestosu</span>
        </a>

        <a 
          href="/takip-listeleri" 
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          <ListChecks class="w-4 h-4" />
          <span>Takip Listeleri</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Core Pillars Grid -->
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Neden Nostr?
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Nostr bir şirket veya kapalı uygulama değil; e-posta gibi evrensel, hafif ve merkeziyetsiz bir protokoldür.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Pillar 1 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 transition-all hover:border-nostr-300 dark:hover:border-nostr-700">
          <div class="w-12 h-12 rounded-xl bg-nostr-100 dark:bg-nostr-950 flex items-center justify-center text-nostr-600 dark:text-nostr-400 mb-4">
            <Key class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Kimlik ve Veri Özgürlüğü</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Hesabın bir şirketin sunucusuna değil, kriptografik anahtarlarına dayanır. Kimse hesabını kapatamaz veya elinden alamaz.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 transition-all hover:border-nostr-300 dark:hover:border-nostr-700">
          <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/60 flex items-center justify-center text-amber-600 dark:text-amber-400 mb-4">
            <Zap class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Lightning & Zaps</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Değer transferi iletişimin merkezindedir. Beğenilerin yerini gerçek mikro ödemeler (Zaps) ve aracısız ödüllendirme alır.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 transition-all hover:border-nostr-300 dark:hover:border-nostr-700">
          <div class="w-12 h-12 rounded-xl bg-rose-100 dark:bg-rose-950/60 flex items-center justify-center text-rose-600 dark:text-rose-400 mb-4">
            <Network class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Merkeziyetsiz Röleler</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Tek bir sunucuya mahkum değilsin. İstediğin kadar röleye bağlanabilir, kendi bağımsız röleni dakikalar içinde başlatabilirsin.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 transition-all hover:border-nostr-300 dark:hover:border-nostr-700">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-4">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Doakrasi & Açık Topluluk</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Hiyerarşi yok; üreten, sorumluluk alan ve geliştiren herkes topluluğun doğal yönlendiricisidir.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Live Relay Diagnostic Showcase -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/30 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Radio class="w-6 h-6 text-nostr-500" />
            <span>Türkiye Resmi Rölesi Canlı Tanı</span>
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            Doğrudan tarayıcınızdan <span class="font-mono text-nostr-600 dark:text-nostr-400">relay.nostr.org.tr</span> WebSocket bağlantı durumunu test edin.
          </p>
        </div>

        <a
          href="/roleler"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-nostr-600 dark:text-nostr-400 hover:underline"
        >
          <span>Tüm Röleleri İncele</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <RelayPingCard relay={communityRelay} />

    </div>
  </section>

  <!-- Quick Navigation Grid -->
  <section class="py-16 bg-white dark:bg-slate-950 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Topluluk Alanları</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Nostr ekosistemini keşfetmek ve katılmak için bölümlere göz atın.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <a href="/topluluk" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <Users class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Topluluk & Ekip
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Kurucular, topluluk üyeleri ve ekip@nostr.org.tr üzerinden çalışma gruplarına katılım rehberi.
          </p>
        </a>

        <a href="/projeler" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <FolderGit2 class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Projeler & Araçlar
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            x2nostr.emre.xyz göç aracı, bridge.workouse.com otomasyonu ve yerli açık kaynak araçlar.
          </p>
        </a>

        <a href="/takip-listeleri" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <ListChecks class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Takip Listeleri
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Akademisyenler, influencerlar, geliştiriciler ve doğrudan Nostr mesajı ile hesap tavsiye etme.
          </p>
        </a>

        <a href="/rehber" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <BookOpen class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Başlangıç Rehberi
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Damus, Amethyst istemcileri, anahtar güvenliği, NIP-05 ve Lightning kurulum dokümanları.
          </p>
        </a>

        <a href="/konusmalar" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <Mic class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Konuşmalar & Sunumlar
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            DevFest Istanbul 2025 sunumu (Nostr: A Protocol for Freedom of Speech) ve slayt arşivi.
          </p>
        </a>

        <a href="/manifesto" class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-nostr-500 transition-all shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 group-hover:scale-110 transition-transform">
              <ScrollText class="w-6 h-6" />
            </div>
            <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-nostr-500 group-hover:translate-x-1 transition-all" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-nostr-600 dark:group-hover:text-nostr-400 transition-colors">
            Topluluk Manifestosu
          </h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Özgür, açık ve sorumlu iletişimin 5 temel ilkesi ve etik kuralları.
          </p>
        </a>

      </div>
    </div>
  </section>

  <!-- Featured Presentation Banner -->
  {latestTalk && (
    <section class="py-12 bg-slate-900 text-white border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-nostr-500/20 text-nostr-300 border border-nostr-500/30">
            <Presentation class="w-3.5 h-3.5" />
            <span>Öne Çıkan Sunum • {latestTalk.event}</span>
          </span>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight">
            {latestTalk.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-400">
            Konuşmacı: {latestTalk.speaker} • {latestTalk.location}
          </p>
        </div>

        <a
          href={latestTalk.slidesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-xs text-slate-900 bg-white hover:bg-slate-100 transition-all flex-shrink-0"
        >
          <span>Slaytları Görüntüle</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </section>
  )}

</Layout>
