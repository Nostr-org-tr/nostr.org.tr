---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import Nip07Tool from '../../components/tools/Nip07Tool.astro';
import { nostrTools } from '../../data/tools';
import { Plug, Lock, Terminal } from 'lucide-astro';

const tool = nostrTools.find((t) => t.id === 'nip07-eklenti-testi')!;
---

<ToolLayout tool={tool}>
  <Nip07Tool />

  <Fragment slot="guide">
    <div class="pt-6 border-t border-slate-100 dark:border-slate-800 space-y-6">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <Plug class="w-4 h-4 text-indigo-500" />
        <span>NIP-07 Protokolü ve Güvenli Oturum Açma</span>
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800 space-y-2">
          <span class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <Lock class="w-4 h-4 text-emerald-500" />
            <span>Özel Anahtarı (nsec) Vermeden Kimlik Doğrulama</span>
          </span>
          <p class="leading-relaxed text-slate-500 dark:text-slate-400">
            NIP-07 sayesinde hiçbir web sitesine nsec anahtarınızı girmeniz gerekmez. Sayfalar oturum açmak veya gönderi göndermek istediğinde tarayıcı uzantınız (Alby, nos2x vb.) bir onay kutusu açar ve imzalama işlemi yerel kasanızda güvenle gerçekleşir.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800 space-y-2">
          <span class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <Terminal class="w-4 h-4 text-indigo-500" />
            <span>Geliştiriciler İçin window.nostr Standartları</span>
          </span>
          <p class="leading-relaxed text-slate-500 dark:text-slate-400">
            Web uygulamalarınızda <code class="text-indigo-600 dark:text-indigo-400 font-mono">window.nostr.getPublicKey()</code> ve <code class="text-indigo-600 dark:text-indigo-400 font-mono">window.nostr.signEvent(event)</code> fonksiyonlarını kullanarak tek satırla Nostr ile Giriş Yap (Sign in with Nostr) akışı oluşturabilirsiniz.
          </p>
        </div>
      </div>
    </div>
  </Fragment>
</ToolLayout>
