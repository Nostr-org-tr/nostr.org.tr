---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import SoftwareApplicationSchema from '../../components/seo/SoftwareApplicationSchema.astro';
import { nostrTools, toolCategories } from '../../data/tools';
import { 
  Sparkles, 
  Search, 
  ArrowRight, 
  ShieldCheck, 
  KeyRound, 
  BadgeCheck, 
  Radio, 
  Plug, 
  Code2, 
  Zap, 
  CheckCircle2,
  Terminal
} from 'lucide-astro';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Araçlar', path: '/araclar' },
];

const iconMap: Record<string, any> = {
  Sparkles,
  KeyRound,
  BadgeCheck,
  Radio,
  Plug,
  Code2,
  Zap,
  ArrowRightLeft: KeyRound,
};
---

<!-- Hallmark · genre: editorial · macrostructure: Workbench · design-system: design.md · designed-as-app -->
<Layout 
  title="Nostr Araçları & Çözümleyicileri | nostr.org.tr"
  description="Nostr protokolü için NIP-19 format dönüştürücü, NIP-05 doğrulayıcı, NIP-07 eklenti testi, canlı röle ping ve Zap denetleyici gibi %100 yerel ve güvenli web araçları."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <SoftwareApplicationSchema 
      name="Nostr Türkiye Araçlar Portalı"
      description="Nostr protokolü için NIP-19 format dönüştürücü, NIP-05 doğrulayıcı, NIP-07 eklenti testi, canlı röle ping ve Zap denetleyici."
      url="/araclar"
    />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-18 space-y-12">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/80 text-purple-900 dark:text-purple-200 border border-purple-200 dark:border-purple-800 shadow-2xs">
        <Terminal class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span class="font-mono uppercase tracking-wider">Workbench</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span>%100 İstemci Taraflı & Güvenli</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Nostr Araçlar Portalı
      </h1>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Nostr ekosisteminde ihtiyaç duyduğunuz anahtar dönüştürücüler, NIP-05 doğrulayıcılar, röle tanı testleri ve eklenti laboratuvarları tek bir güvenli adreste.
      </p>

      <!-- Client-side Security Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-medium shadow-2xs">
        <ShieldCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" />
        <span>Tüm araçlar tarayıcınızda yerel çalışır; hiçbir özel anahtar veya veri sunucuya iletilmez.</span>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="space-y-4 max-w-4xl mx-auto">
      
      <!-- Live Search Bar -->
      <div class="relative">
        <Search class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" />
        <input
          id="tools-search-input"
          type="text"
          placeholder="Araç adı, NIP standardı veya özellik ara... (ör: npub, nip-05, zap, röle)"
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-[#faf9f5] dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500 transition-all shadow-2xs placeholder:text-slate-400"
        />
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-1" id="category-filters">
        {toolCategories.map((cat) => {
          const Icon = iconMap[cat.icon] || Sparkles;
          return (
            <button
              type="button"
              class={`cat-filter-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold font-mono transition-all ${
                cat.key === 'all'
                  ? 'bg-purple-700 text-white shadow-xs'
                  : 'bg-[#faf9f5] dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-purple-400 hover:text-slate-900 dark:hover:text-white'
              }`}
              data-cat-key={cat.key}
            >
              <Icon class="w-3.5 h-3.5" />
              <span>{cat.label}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Tools Grid Stream -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid-container">
      {nostrTools.map((tool) => {
        const Icon = iconMap[tool.icon] || Sparkles;
        return (
          <div 
            class="tool-card group p-6 sm:p-7 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 hover:border-purple-400 dark:hover:border-purple-600 transition-all flex flex-col justify-between shadow-2xs hover:shadow-xs space-y-5"
            data-tool-id={tool.id}
            data-category={tool.category}
            data-search-corpus={`${tool.title} ${tool.shortTitle} ${tool.summary} ${tool.description} ${tool.nips.join(' ')} ${tool.features.join(' ')}`.toLowerCase()}
          >
            <div class="space-y-4">
              <!-- Top Category & NIP Badges -->
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold font-mono uppercase tracking-wider bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                  {tool.categoryLabel}
                </span>

                <div class="flex items-center gap-1 flex-wrap">
                  {tool.nips.map((nip) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200/80 dark:border-slate-700/80">
                      {nip}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Icon & Title -->
              <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-2xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform border border-purple-200 dark:border-purple-800/80 shadow-2xs">
                  <Icon class="w-5 h-5" />
                </div>
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-purple-700 dark:group-hover:text-purple-300 transition-colors leading-snug">
                    <a href={tool.href} class="focus:outline-none">
                      {tool.title}
                    </a>
                  </h2>
                  {tool.badge && (
                    <span class="inline-block mt-1 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400 font-mono">
                      ● {tool.badge}
                    </span>
                  )}
                </div>
              </div>

              <!-- Summary -->
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
                {tool.summary}
              </p>

              <!-- Feature Highlights List -->
              <ul class="space-y-1.5 pt-2 border-t border-slate-200 dark:border-slate-800/80 text-xs text-slate-500 dark:text-slate-400">
                {tool.features.slice(0, 3).map((feat) => (
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400 flex-shrink-0 mt-0.5" />
                    <span class="line-clamp-1">{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Button -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80 flex items-center justify-between">
              <a
                href={tool.href}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-purple-700 dark:text-purple-300 bg-white dark:bg-slate-800 hover:bg-purple-50 dark:hover:bg-purple-950 border border-slate-300 dark:border-slate-700 transition-all group-hover:border-purple-400 shadow-2xs"
              >
                <span>Aracı Başlat</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </a>

              <span class="text-[11px] font-mono text-slate-400 dark:text-slate-500">
                Client-Side
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-tools-found" class="hidden text-center py-16 space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
        <Search class="w-6 h-6" />
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Aradığınız kriterlere uygun araç bulunamadı</h3>
      <p class="text-xs text-slate-500 dark:text-slate-400">Farklı anahtar kelimeler veya NIP numarası deneyebilirsiniz.</p>
    </div>

  </div>

  <script is:inline>
    const setupToolsFilter = () => {
      const searchInput = document.getElementById('tools-search-input');
      const catButtons = document.querySelectorAll('.cat-filter-btn');
      const toolCards = document.querySelectorAll('.tool-card');
      const noResults = document.getElementById('no-tools-found');
      if (!searchInput || !toolCards.length) return;

      let currentCat = 'all';
      let currentQuery = '';

      const filterTools = () => {
        let visibleCount = 0;

        toolCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const corpus = card.getAttribute('data-search-corpus') || '';

          const matchesCat = currentCat === 'all' || cardCat === currentCat;
          const matchesQuery = !currentQuery || corpus.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      };

      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target.value || '').trim().toLowerCase();
        filterTools();
      });

      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          catButtons.forEach((b) => {
            b.classList.remove('bg-purple-700', 'text-white', 'shadow-xs');
            b.classList.add('bg-[#faf9f5]', 'dark:bg-slate-900', 'border', 'border-slate-200/90', 'dark:border-slate-800', 'text-slate-600', 'dark:text-slate-300');
          });

          btn.classList.add('bg-purple-700', 'text-white', 'shadow-xs');
          btn.classList.remove('bg-[#faf9f5]', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-300');

          currentCat = btn.getAttribute('data-cat-key') || 'all';
          filterTools();
        });
      });
    };

    setupToolsFilter();
    document.addEventListener('astro:after-swap', setupToolsFilter);
  </script>

</Layout>
