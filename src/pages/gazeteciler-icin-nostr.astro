---
import Layout from '../layouts/Layout.astro';
import CopyButton from '../components/CopyButton.astro';
import { 
  Newspaper, 
  ShieldCheck, 
  Key, 
  Radio, 
  Lock, 
  Zap, 
  BadgeCheck, 
  Scale, 
  AlertTriangle, 
  ArrowRight, 
  Sparkles,
  BookOpen,
  Clock
} from 'lucide-astro';

import ArticleSchema from '../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Kaynaklar', path: '/rehber' },
  { name: 'Gazeteciler İçin Nostr Kılavuzu', path: '/gazeteciler-icin-nostr' },
];

const publishedDate = "2025-01-15";
const modifiedDate = "2026-08-31";
---

<Layout 
  title="Gazeteciysen Bilmen Gerekenler: Dijital Baskı Çağında Özgür ve Dayanıklı Habercilik | Nostr Türkiye"
  description="Türkiye'de haber alma hakkı, merkezi sosyal medya sansürü, hesap kapatma riskleri ve gazetecilerin bağımsızlıklarını korumak için neden Nostr kullanması gerektiğine dair kapsamlı rehber."
  ogType="article"
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <ArticleSchema
      title="Gazeteciysen Bilmen Gerekenler: Dijital Baskı Çağında Özgür ve Dayanıklı Habercilik"
      description="Türkiye'de haber alma hakkı, merkezi sosyal medya sansürü, hesap kapatma riskleri ve gazetecilerin bağımsızlıklarını korumak için neden Nostr kullanması gerektiğine dair kapsamlı rehber."
      path="/gazeteciler-icin-nostr"
      inLanguage="tr-TR"
      datePublished={publishedDate}
      dateModified={modifiedDate}
    />
  </Fragment>

  <!-- Hero Header -->
  <header class="py-14 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-slate-50 via-white to-slate-50/50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-nostr-100 text-nostr-700 dark:bg-nostr-950 dark:text-nostr-300 border border-nostr-200 dark:border-nostr-800">
          <Newspaper class="w-3.5 h-3.5" />
          <span>Basın & Medya Kılavuzu</span>
        </span>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
          <Clock class="w-3 h-3" />
          <span>8 dk okuma</span>
        </span>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          <ShieldCheck class="w-3 h-3" />
          <span>Hukuki & Teknik Çerçeve</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.2]">
        Gazeteciysen Bilmen Gerekenler: <br class="hidden sm:inline" />
        <span class="nostr-gradient-text">Dijital Baskı Çağında Özgür ve Dayanıklı Habercilik</span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Merkezi sosyal medya platformlarının keyfi hesap kapatmaları, algoritmik görünürlük engelleri (shadowban) ve dijital tekelleşme çağında; haberin, kaynağın ve gazetecinin bağımsızlığını teminat altına alan açık iletişim protokolü Nostr'ı neden öğrenmeli, kullanmalı ve savunmalısınız?
      </p>

      <!-- Key Takeaways Bar -->
      <div class="mt-8 p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-600 dark:text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-2.5 h-2.5 rounded-full bg-tr-red animate-pulse"></div>
          <span>Hedef: Muhabirler, Yazarlar, Bağımsız Medya & Haber Odaları</span>
        </div>
        <div class="flex items-center gap-2 font-mono text-[11px]">
          <span>Protokol Standardı: NIP-01 / NIP-05 / NIP-44</span>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Article Body -->
  <main class="py-12 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-12 sm:space-y-16">

      <!-- Section 1: Introduction & The Problem of Platform Tenancy -->
      <section class="space-y-5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 inline-flex items-center justify-center text-sm font-mono font-bold">01</span>
          <span>Merkezi Platform Paradoksu: "Platform Kiracılığı"</span>
        </h2>

        <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          Bugün bir gazetecinin en değerli sermayesi nedir? <strong>Güvenilirliği, arşivi ve okurlarıyla kurduğu doğrudan bağdır.</strong> Ancak son 15 yılda gazeteciler, bu üç hayati unsuru Silikon Vadisi merkezli birkaç dev şirketin (X/Twitter, Meta, YouTube, TikTok) özel mülkiyetindeki sunuculara emanet etti.
        </p>

        <div class="p-5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 space-y-2">
          <div class="flex items-center gap-2 font-semibold text-sm text-amber-900 dark:text-amber-300">
            <AlertTriangle class="w-4 h-4 text-amber-600 dark:text-amber-400" />
            <span>Merkezi Sosyal Ağlarda Karşılaşılan Temel Riskler:</span>
          </div>
          <ul class="space-y-1.5 text-xs sm:text-sm text-amber-900/90 dark:text-amber-200/90 list-disc list-inside">
            <li><strong>Tek Taraflı Hesap Kapatma (Deplatforming):</strong> On yıllık emeğiniz, haber arşiviniz ve yüz binlerce takipçiniz tek bir otomatik algoritma kararı veya platform yöneticisinin inisiyatifiyle bir gecede silinebilir.</li>
            <li><strong>Algoritmik Görünürlük Kısıtlaması (Shadowban):</strong> Kamu yararı taşıyan haberleriniz, platformun para kazanma ya da etkileşim algoritmalarına uymadığı gerekçesiyle okurlarınızın akışından gizlenir.</li>
            <li><strong>Mavi Tik İllüzyonu ve Sahte Hesaplar:</strong> Aylık abonelik ücreti ödeyen herkesin "onaylı" göründüğü bir düzende, gazetecilerin ve haber merkezlerinin kimlik taklidi kolaylaşır, dezenformasyon yayılır.</li>
            <li><strong>Arşiv Kaybı:</strong> Platformlar kapandığında, erişim engeline uğradığında veya şirket el değiştirdiğinde gazetecinin tüm dijital hafızası kaybolma riskiyle yüz yüze kalır.</li>
          </ul>
        </div>

        <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          Biz buna <strong>"Platform Kiracılığı"</strong> diyoruz. Ev sahibi kirayı artırabilir, kuralları değiştirebilir veya sizi gerekçesiz kapının önüne koyabilir. Nostr ise gazeteciye kiracılığı bırakıp <strong>kendi dijital mülkünün sahibi olma</strong> gücü verir.
        </p>
      </section>

      <!-- Section 2: Legal & Constitutional Context in Turkey -->
      <section class="space-y-5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 inline-flex items-center justify-center text-sm font-mono font-bold">02</span>
          <span>Hukuki Çerçeve: Anayasal Haklar ve İletişim Güvenliği</span>
        </h2>

        <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          Nostr protokolünü kullanmak, savunmak ve yaygınlaştırmak; tamamen Türkiye Cumhuriyeti Anayasası ve evrensel hukuk normları çerçevesinde meşru bir iletişim ve teknoloji tercihidir.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
              <Scale class="w-4 h-4 text-nostr-500" />
              <span>T.C. Anayasası Madde 26</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              <em>"Herkes, düşünce ve kanaatlerini söz, yazı, resim veya başka yollarla tek başına veya toplu olarak açıklama ve yayma hakkına sahiptir. Bu hürriyet resmi makamların müdahalesi olmaksızın haber veya fikir almak ya da vermek serbestliğini de kapsar."</em>
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
              <Scale class="w-4 h-4 text-nostr-500" />
              <span>T.C. Anayasası Madde 28</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              <em>"Basın hürdür, sansür edilemez. Basımevi kurmak izin alma ve mali teminat yatırma şartına bağlanamaz. Devlet, basın ve haber alma hürriyetlerini sağlayacak tedbirleri alır."</em>
            </p>
          </div>
        </div>

        <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          Nostr, tıpkı e-posta (SMTP) veya web (HTTP) protokolleri gibi nötr bir matematiksel standarttır. Herhangi bir suç teşkil etmez; aksine gazetecilere basın etiğine uygun haberlerini tahrifatsız biçimde kamuoyuna ulaştırma imkânı sağlar.
        </p>
      </section>

      <!-- Section 3: 5 Pillars Why Journalists Must Use & Praise Nostr -->
      <section class="space-y-6">
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 inline-flex items-center justify-center text-sm font-mono font-bold">03</span>
            <span>Bir Gazetecinin Nostr'ı Kullanması İçin 5 Neden</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
            Nostr protokolünün mimarisi, geleneksel haber odalarının ve bağımsız gazetecilerin dijital ihtiyaçlarına doğrudan yanıt verir.
          </p>
        </div>

        <div class="space-y-6">
          
          <!-- Pillar 1 -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400">
                <Key class="w-5 h-5" />
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                1. Kriptografik Kimlik ve Sıfır Kapatılma Riski (npub / nsec)
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-2">
              Nostr'da hesabınız bir şirketin sunucusunda kayıtlı bir satır değildir. Kimliğiniz bir matematiksel anahtar çiftidir (Public Key: <code class="font-mono text-xs text-nostr-600 dark:text-nostr-400">npub</code> ve Private Key: <code class="font-mono text-xs text-nostr-600 dark:text-nostr-400">nsec</code>). Takipçileriniz ve gönderileriniz bu anahtara bağlıdır. Hiçbir CEO, moderatör veya şirket bu anahtarı elinizden alamaz, hesabınızı askıya alamaz.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">
                <Radio class="w-5 h-5" />
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                2. Dağıtık Röleler ile Kesintisiz Haber Dağıtımı
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-2">
              Haberinizi tek bir sunucuya göndermezsiniz; aynı anda Türkiye'deki (<code class="font-mono text-xs text-blue-600 dark:text-blue-400">relay.nostr.org.tr</code>) ve dünyanın dört bir yanındaki yüzlerce bağımsız röleye (relay) iletirsiniz. Rölelerden biri kapansa veya engellense bile haberiniz diğer yüzlerce rölede yaşamaya ve okurlara ulaşmaya devam eder.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-purple-100 dark:bg-purple-950 text-purple-600 dark:text-purple-400">
                <BadgeCheck class="w-5 h-5" />
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                3. Kurumsal Doğrulama ve Sahte Hesap Koruması (NIP-05)
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-2">
              Parayla satılan mavi tikler yerine Nostr'da NIP-05 standardı kullanılır. Bir gazete veya haber kurumu kendi alan adında (<code class="font-mono text-xs text-purple-600 dark:text-purple-400">gazete.com/.well-known/nostr.json</code>) muhabirlerini listeler. Örneğin <strong class="font-mono text-slate-900 dark:text-white">ahmet@gazete.com</strong> şeklinde doğrulanmış kimlik görünür. Kimse kurumunuzun adını taklit edemez, sahte haber üretemez.
            </p>
          </div>

          <!-- Pillar 4 -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400">
                <Lock class="w-5 h-5" />
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                4. Kaynak Gizliliği ve Uçtan Uca Şifreleme (NIP-44)
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-2">
              Gazetecilikte haber kaynağının gizliliği kutsaldır. Merkezi platformların direkt mesajları (DM) şirket yöneticileri ve veritabanı denetçileri tarafından okunabilir. Nostr NIP-44 standardı ile mesajlar doğrudan iki tarafın açık anahtarlarıyla şifrelenir (E2EE); aradaki röleler veya üçüncü taraflar içeriği asla çözemez.
            </p>
          </div>

          <!-- Pillar 5 -->
          <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400">
                <Zap class="w-5 h-5" />
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                5. Aracısız Okur Desteği ve Finansal Bağımsızlık (Zaps)
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-2">
              Reklam verenlerin baskısı ve aracı ödeme komisyonları bağımsız haberciliği zayıflatır. Nostr'ın Lightning Network entegrasyonu (NIP-57 Zaps) sayesinde, dünyanın her yerindeki okurlar beğendikleri bir araştırmacı habere saniyeler içinde 100 satoshi veya diledikleri miktarda doğrudan mikro ödeme gönderebilir.
            </p>
          </div>

        </div>
      </section>

      <!-- Section 4: 15-Minute Action Plan for Journalists -->
      <section class="space-y-6">
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 inline-flex items-center justify-center text-sm font-mono font-bold">04</span>
            <span>Gazeteciler İçin 15 Dakikalık Hızlı Başlangıç</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
            Nostr ağına katılmak için karmaşık teknik adımlara ihtiyacınız yok. İşte adım adım yol haritası:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Step 1 -->
          <div class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-nostr-600 dark:text-nostr-400 uppercase tracking-wider">Adım 1</span>
              <span class="w-6 h-6 rounded-full bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 flex items-center justify-center text-xs font-bold">1</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">İstemci Seçin ve Profil Açın</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Telefonunuza veya tarayıcınıza bir Nostr istemcisi yükleyin:
            </p>
            <ul class="text-xs space-y-1 text-slate-600 dark:text-slate-300">
              <li>• <strong>Türkçe & Çoklu Platform:</strong> Nostrich (Web / iOS / Android / Mac)</li>
              <li>• <strong>iPhone / Mac:</strong> Damus veya Primal</li>
              <li>• <strong>Android:</strong> Amethyst veya Primal</li>
              <li>• <strong>Web:</strong> Coracle veya Primal.net</li>
            </ul>
          </div>

          <!-- Step 2 -->
          <div class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Adım 2 • Kritik</span>
              <span class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xs font-bold">2</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Gizli Anahtarınızı (nsec) Yedekleyin</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Uygulama size <code class="font-mono text-[11px] text-rose-600 dark:text-rose-400">nsec1...</code> ile başlayan gizli anahtar verir. Bu anahtar şifreniz ve imzanızdır. Asla kimseyle paylaşmayın, şifreli bir parola yöneticisinde veya fiziksel olarak saklayın.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-nostr-600 dark:text-nostr-400 uppercase tracking-wider">Adım 3</span>
              <span class="w-6 h-6 rounded-full bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 flex items-center justify-center text-xs font-bold">3</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Türkiye Rölesini Ekleyin</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              İstemcinizin Röle (Relay) ayarlarına giderek topluluk rölemizi ekleyin:
            </p>
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-mono text-slate-800 dark:text-slate-200">
              <span class="truncate">wss://relay.nostr.org.tr</span>
              <CopyButton text="wss://relay.nostr.org.tr" label="Kopyala" className="text-xs py-1" />
            </div>
          </div>

          <!-- Step 4 -->
          <div class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-nostr-600 dark:text-nostr-400 uppercase tracking-wider">Adım 4</span>
              <span class="w-6 h-6 rounded-full bg-nostr-100 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 flex items-center justify-center text-xs font-bold">4</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">NIP-05 Alan Adınızı Bağlayın</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
