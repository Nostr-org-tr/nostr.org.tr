---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import WhatWeNeedSection from '../components/WhatWeNeedSection.astro';
import ServerSupportCard from '../components/ServerSupportCard.astro';
import { members } from '../data/members';
import { Users, HeartHandshake, ArrowRight } from 'lucide-astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Topluluk & Ekip', path: '/topluluk' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Tabular Index · design-system: design.md · designed-as-app -->
<Layout 
  title="Topluluk ve Ekip - Nostr Türkiye Topluluğu"
  description="Nostr Türkiye topluluğu kurucuları, aktif üyeleri, doakrasi yönetim modeli, açık topluluk rolleri ve çalışma grupları katılım rehberi."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  
  <!-- Header Banner -->
  <section class="py-16 sm:py-22 border-b border-slate-200/90 dark:border-slate-800/90 bg-[#faf9f5] dark:bg-[#0b0f19]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800 mb-6 shadow-2xs">
        <Users class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span class="font-mono uppercase tracking-wider">Topluluk</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span>Hiyerarşisiz Doakrasi</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Topluluk & Ekip
      </h1>
      <p class="mt-4 text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Doakrasi (Do-ocracy) esasına dayalı; unvanlarla değil, ürettiği değer ve katkıyla şekillenen bağımsız topluluk yapımız.
      </p>
    </div>
  </section>

  <!-- Members & Roles Section -->
  <section class="py-16 sm:py-20 bg-white dark:bg-[#0e1322]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Topluluk Üyeleri -->
      <div>
        <div class="flex items-center justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-1 font-semibold">
              Kadro & Kolaylaştırıcılar
            </p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Topluluk Kolaylaştırıcıları ve Üyeleri</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Nostr Türkiye ekosistemini inşa eden ve kolaylaştıran isimler.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {members.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      </div>

      <!-- What We Need / Open Community Roles -->
      <WhatWeNeedSection />

      <!-- Do-ocracy Philosophy Box -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 space-y-4 shadow-xs">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 flex items-center justify-center">
            <HeartHandshake class="w-5 h-5" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">
            Doakrasi Nedir? Nasıl Karar Alırız?
          </h3>
        </div>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
          Nostr Türkiye'de bürokrasi, oylama kilitlenmeleri veya katı yöneticiler yoktur. Bir fikir veya ihtiyaç varsa, sorumluluğu alıp üreten kişi o çalışmanın doğal lideridir. Kararlar katı emirlerle değil, açık tartışma ve kaba fikir birliği (rough consensus) ile alınır.
        </p>
        <div class="pt-2">
          <a href="/manifesto#madde-2" class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-700 dark:text-purple-300 hover:underline">
            <span>Manifestodaki Örgütlenme Maddesini Oku</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Server Costs & Support -->
      <ServerSupportCard />

    </div>
  </section>

  <!-- Dynamic Nostr Profiles Fetcher Script -->
  <script>
    import { fetchNostrProfiles } from '../utils/nostrProfileFetcher';

    fetchNostrProfiles('[data-member-card]');
    document.addEventListener('astro:page-load', () => fetchNostrProfiles('[data-member-card]'));
    document.addEventListener('astro:after-swap', () => fetchNostrProfiles('[data-member-card]'));
  </script>

</Layout>
