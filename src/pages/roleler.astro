---
import Layout from '../layouts/Layout.astro';
import RelayPingCard from '../components/RelayPingCard.astro';
import BlossomPingCard from '../components/BlossomPingCard.astro';
import ServerSupportCard from '../components/ServerSupportCard.astro';
import CopyButton from '../components/CopyButton.astro';
import { communityRelay, cacheRelay, recommendedRelays } from '../data/relays';
import { communityBlossomServer, recommendedBlossomServers } from '../data/blossom';
import { Radio, HardDrive, HelpCircle, CheckCircle2, ArrowRight } from 'lucide-astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Röleler & Medya Sunucuları', path: '/roleler' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Tabular Index · design-system: design.md · designed-as-app -->
<Layout 
  title="Röleler & Blossom Medya Sunucuları - Nostr Türkiye Topluluğu"
  description="Nostr Türkiye resmi rölesi (relay.nostr.org.tr), pull-through cache rölesi (cache.nostr.org.tr), Blossom medya sunucusu (media.nostr.org.tr), küresel açık mirrorlar ve istemci kurulum rehberi."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  
  <!-- Header Banner -->
  <section class="py-16 sm:py-22 border-b border-slate-200/90 dark:border-slate-800/90 bg-[#faf9f5] dark:bg-[#0b0f19]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800 mb-6 shadow-2xs">
        <Radio class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span class="font-mono uppercase tracking-wider">Ağ Durumu</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span>Canlı WebSocket & Blossom Altyapısı</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Türkiye & Küresel Altyapı
      </h1>
      <p class="mt-4 text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Nostr'da metin mesajları bağımsız rölelerde, medya dosyaları ise Blossom blob sunucularında taşınır. Canlı gecikme sürelerini test edin ve adresleri istemcinize ekleyin.
      </p>
    </div>
  </section>

  <!-- Main Infrastructure Grid -->
  <section class="py-16 sm:py-20 bg-white dark:bg-[#0e1322]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section 1: Official Community Infrastructure Spotlight -->
      <div>
        <div class="flex items-center justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-1 font-semibold">
              Topluluk Altyapısı
            </p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>Resmi Topluluk Altyapısı</span>
              <span class="w-2.5 h-2.5 rounded-full bg-tr-red"></span>
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
              Türkiye topluluğu için barındırılan resmi iletişim rölesi, pull-through cache rölesi ve Blossom medya sunucusu.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <RelayPingCard relay={communityRelay} />
          <RelayPingCard relay={cacheRelay} />
          <BlossomPingCard server={communityBlossomServer} />
        </div>
      </div>

      <!-- Section 2: Recommended Relays -->
      <div>
        <div class="flex items-center justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-1 font-semibold">
              Küresel Dağıtık Ağ
            </p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <Radio class="w-6 h-6 text-purple-600 dark:text-purple-400" />
              <span>Tavsiye Edilen Küresel Röleler</span>
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
              Ağ dayanıklılığını artırmak için istemcinize birden fazla açık röle ekleyebilirsiniz.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recommendedRelays.filter(r => !r.isOfficialCommunityRelay).map((relay) => (
            <RelayPingCard relay={relay} />
          ))}
        </div>
      </div>

      <!-- Section 3: Recommended Blossom & Mirror Servers -->
      <div id="blossom">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-1 font-semibold">
              Blob Depolama
            </p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <HardDrive class="w-6 h-6 text-purple-600 dark:text-purple-400" />
              <span>Açık Blossom Medya & Mirror Sunucuları</span>
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
              Medya içeriklerinizin kaybolmaması için tek bir sunucu yerine ayna (mirror) sunucuları da yapılandırmanız önerilir.
            </p>
          </div>

          <a
            href="/rehber#blossom-medya-sunuculari"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-700 dark:text-purple-300 hover:underline"
          >
            <span>Blossom & Mirror Kılavuzunu Oku</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recommendedBlossomServers.filter(s => !s.isOfficialCommunityServer).map((server) => (
            <BlossomPingCard server={server} showMirrorList={false} />
          ))}
        </div>
      </div>

      <!-- Server Costs & Support Card -->
      <div>
        <ServerSupportCard />
      </div>

      <!-- How to add relays & blossom servers guide -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 space-y-8 shadow-xs">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 flex items-center justify-center">
            <HelpCircle class="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">
              İstemcinize Röle ve Medya Sunucusu Nasıl Eklenir?
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
              İstemcilerinizde hem metin rölelerini hem de Blossom medya sunucularını tanımlayarak tam merkeziyetsizlik sağlayın.
            </p>
          </div>
        </div>

        <!-- Relay Configuration Cards -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 font-mono">
            1. Röle Ekleme (relay.nostr.org.tr)
          </h4>
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono">
            <div class="space-y-1">
              <span class="text-slate-500 block text-[11px]">Birincil Röle Adresi:</span>
              <span class="font-bold text-slate-900 dark:text-white">wss://relay.nostr.org.tr</span>
            </div>
            <CopyButton text="wss://relay.nostr.org.tr" label="Röle Adresini Kopyala" />
          </div>
        </div>

        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 font-mono">
            2. Blossom Sunucusu Ekleme (media.nostr.org.tr)
          </h4>
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono">
            <div class="space-y-1">
              <span class="text-slate-500 block text-[11px]">Resmi Medya Sunucusu Endpointi:</span>
              <span class="font-bold text-slate-900 dark:text-white">https://media.nostr.org.tr</span>
            </div>
            <CopyButton text="https://media.nostr.org.tr" label="Blossom Adresini Kopyala" />
          </div>
        </div>

        <div class="pt-2 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" />
          <span>Amethyst, Primal, Coracle ve Damus istemcilerinin "Ayarlar > Röleler / Medya Sunucuları" menüsünden ekleyebilirsiniz.</span>
        </div>
      </div>

    </div>
  </section>
</Layout>
