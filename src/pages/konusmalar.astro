---
import Layout from '../layouts/Layout.astro';
import TalkCard from '../components/TalkCard.astro';
import { talks } from '../data/talks';
import { Mic, Presentation, Mail, ArrowRight } from 'lucide-astro';
import EventSchema from '../components/seo/EventSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Konuşmalar & Sunumlar', path: '/konusmalar' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Tabular Index · design-system: design.md · designed-as-app -->
<Layout 
  title="Konuşmalar & Sunumlar - Nostr Türkiye"
  description="DevFest Istanbul 2025 ve diğer teknoloji konferanslarında Nostr protokolü üzerine gerçekleştirilen sunumlar, slaytlar ve etkinlik arşivi."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <EventSchema talks={talks} />
  </Fragment>
  
  <!-- Header Banner -->
  <section class="py-16 sm:py-22 border-b border-slate-200/90 dark:border-slate-800/90 bg-[#faf9f5] dark:bg-[#0b0f19]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800 mb-6 shadow-2xs">
        <Mic class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span class="font-mono uppercase tracking-wider">Etkinlikler</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span>Sunum & Konuşma Kayıtları</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Konuşmalar & Sunumlar
      </h1>
      <p class="mt-4 text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Türkiye'de ve uluslararası arenada Nostr protokolünü, sansürsüz iletişimi ve açık internet vizyonunu anlattığımız sunumlar.
      </p>
    </div>
  </section>

  <!-- Talks Stream -->
  <section class="py-16 sm:py-20 bg-white dark:bg-[#0e1322]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- List of Talks -->
      <div class="space-y-6">
        {talks.map((talk) => (
          <TalkCard talk={talk} />
        ))}
      </div>

      <!-- Invite Speaker CTA -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xs">
        <div class="space-y-2 max-w-2xl">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Presentation class="w-5 h-5 text-purple-600 dark:text-purple-400" />
            <span>Etkinliğinize Konuşmacı Davet Edin</span>
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Üniversite kulübünüzde, şirketinizde veya teknoloji buluşmalarınızda Nostr, kriptografi ve merkeziyetsiz protokoller üzerine bir sunum mu istiyorsunuz?
          </p>
        </div>

        <a
          href="mailto:ekip@nostr.org.tr?subject=Nostr%20Konu%C5%9Fmac%C4%B1%20Daveti"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-xs text-white bg-purple-700 hover:bg-purple-800 shadow-sm transition-all active:scale-[0.98] flex-shrink-0"
        >
          <Mail class="w-4 h-4" />
          <span>Konuşmacı Talep Et</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

    </div>
  </section>

</Layout>
