---
import Layout from '../../layouts/Layout.astro';
import { manifestoData } from '../../data/manifesto';
import { 
  ScrollText, 
  Key, 
  Users, 
  Scale, 
  HeartHandshake, 
  Zap, 
  Languages, 
  ArrowRight, 
  Quote,
  Sparkles
} from 'lucide-astro';

import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';

const pillarIcons = [Key, Users, Scale, HeartHandshake, Zap];

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Community Manifesto', path: '/en/manifesto' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<Layout 
  title="Nostr Türkiye Community Manifesto - Free, Open, and Responsible Communication"
  description="Official manifesto of the Nostr Türkiye community: foundational principles, do-ocracy organizational model, legal boundaries, ethics, and value-for-value communication."
  isEn={true}
  ogType="article"
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <ArticleSchema
      title="Nostr Türkiye Community Manifesto - Free, Open, and Responsible Communication"
      description="Official manifesto of the Nostr Türkiye community: foundational principles, do-ocracy organizational model, legal boundaries, ethics, and value-for-value communication."
      path="/en/manifesto"
      inLanguage="en-US"
      datePublished="2025-01-01"
      dateModified="2026-08-31"
    />
  </Fragment>
  
  <!-- Hero Header -->
  <section class="py-16 sm:py-24 border-b border-slate-200/90 dark:border-slate-800/90 bg-[#faf9f5] dark:bg-[#0b0f19]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Bilingual Switch Notice -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-900 dark:bg-purple-950/80 dark:text-purple-200 border border-purple-200 dark:border-purple-800 mb-8 shadow-xs">
        <ScrollText class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" />
        <span>Official Community Charter</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <a 
          href="/manifesto" 
          class="inline-flex items-center gap-1 text-rose-600 dark:text-rose-400 hover:underline font-bold"
        >
          <Languages class="w-3 h-3 text-rose-600" />
          <span>Türkçe Orijinalini Oku</span>
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Nostr Türkiye Community Manifesto
      </h1>
      <p class="mt-4 text-base sm:text-xl font-medium text-purple-700 dark:text-purple-300">
        The Future of Free, Open, and Responsible Communication
      </p>

      <!-- Manifesto Lead Statement: Typographic Card -->
      <div class="mt-10 p-7 sm:p-9 rounded-2xl bg-white dark:bg-[#0e1322] border border-slate-200/90 dark:border-slate-800 shadow-xs text-left relative">
        <Quote class="w-10 h-10 text-purple-200 dark:text-purple-950/80 absolute top-5 right-5 pointer-events-none" />
        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
          {manifestoData.leadEn}
        </p>
      </div>

    </div>
  </section>

  <!-- 5 Foundational Pillars: Long Document -->
  <section class="py-16 sm:py-24 bg-white dark:bg-[#0e1322]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {manifestoData.pillars.map((pillar, idx) => {
        const Icon = pillarIcons[idx] || Sparkles;
        return (
          <article 
            id={`pillar-${pillar.number}`} 
            class="p-7 sm:p-10 rounded-3xl bg-[#faf9f5] dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 transition-all hover:border-slate-300 dark:hover:border-slate-700 shadow-xs"
          >
            <!-- Pillar Header -->
            <div class="flex items-start gap-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-950/80 flex items-center justify-center text-purple-700 dark:text-purple-300 flex-shrink-0 font-mono font-bold text-lg border border-purple-200 dark:border-purple-800/80 shadow-2xs">
                <Icon class="w-6 h-6" />
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-purple-700 dark:text-purple-400 font-mono">
                  Pillar {pillar.number}
                </span>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
                  {pillar.titleEn}
                </h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                  {pillar.subtitleEn}
                </p>
              </div>
            </div>

            <!-- Items within Pillar -->
            <div class="grid grid-cols-1 gap-6 pt-5 border-t border-slate-200 dark:border-slate-800">
              {pillar.itemsEn.map((item) => (
                <div class="space-y-1.5">
                  <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-purple-600 dark:bg-purple-400"></span>
                    {item.title}
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-4">
                    {item.body}
                  </p>
                </div>
              ))}
            </div>

          </article>
        );
      })}

      <!-- Final Callout & Conclusion -->
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-950 text-white shadow-xl text-center space-y-6 border border-slate-800">
        <p class="text-base sm:text-lg font-medium text-slate-300">
          {manifestoData.conclusionEn.lead}
        </p>
        <blockquote class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white font-serif">
          "{manifestoData.conclusionEn.quote}"
        </blockquote>
        <p class="text-sm sm:text-base text-slate-400 max-w-xl mx-auto">
          {manifestoData.conclusionEn.invite}
        </p>
        
        <div class="pt-4 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href="/rehber"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all active:scale-[0.98]"
          >
            <span>Read Beginner's Guide</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="/topluluk"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-white/10 hover:bg-white/15 text-white border border-white/20 transition-all active:scale-[0.98]"
          >
            <span>Join Community</span>
            <Users class="w-4 h-4" />
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
