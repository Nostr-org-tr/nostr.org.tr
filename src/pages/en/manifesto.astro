---
import Layout from '../../layouts/Layout.astro';
import { manifestoData } from '../../data/manifesto';
import { 
  ScrollText, 
  Key, 
  Users, 
  Scale, 
  HeartHandshake, 
  Zap, 
  Languages, 
  ArrowRight, 
  Quote,
  Sparkles
} from 'lucide-astro';

import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';

const pillarIcons = [Key, Users, Scale, HeartHandshake, Zap];

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Community Manifesto', path: '/en/manifesto' },
];
---

<Layout 
  title="Nostr Türkiye Community Manifesto - Free, Open, and Responsible Communication"
  description="Official manifesto of the Nostr Türkiye community: foundational principles, do-ocracy organizational model, legal boundaries, ethics, and value-for-value communication."
  isEn={true}
  ogType="article"
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <ArticleSchema
      title="Nostr Türkiye Community Manifesto - Free, Open, and Responsible Communication"
      description="Official manifesto of the Nostr Türkiye community: foundational principles, do-ocracy organizational model, legal boundaries, ethics, and value-for-value communication."
      path="/en/manifesto"
      inLanguage="en-US"
      datePublished="2025-01-01"
      dateModified="2026-08-31"
    />
  </Fragment>
  
  <!-- Hero Header -->
  <section class="py-16 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-white via-slate-50 to-slate-100/50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Bilingual Switch Notice -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-nostr-50 text-nostr-700 dark:bg-nostr-950 dark:text-nostr-300 border border-nostr-200 dark:border-nostr-800 mb-6 shadow-sm">
        <ScrollText class="w-3.5 h-3.5 text-nostr-500" />
        <span>Official Community Charter</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <a 
          href="/manifesto" 
          class="inline-flex items-center gap-1 text-nostr-600 dark:text-nostr-400 hover:underline font-bold"
        >
          <Languages class="w-3 h-3 text-tr-red" />
          <span>Türkçe Orijinalini Oku</span>
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.2]">
        Nostr Türkiye Community Manifesto
      </h1>
      <p class="mt-4 text-base sm:text-xl font-medium text-nostr-600 dark:text-nostr-400">
        The Future of Free, Open, and Responsible Communication
      </p>

      <!-- Manifesto Lead Statement -->
      <div class="mt-8 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-left relative">
        <Quote class="w-10 h-10 text-nostr-200 dark:text-nostr-900/60 absolute top-4 right-4 pointer-events-none" />
        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
          {manifestoData.leadEn}
        </p>
      </div>

    </div>
  </section>

  <!-- 5 Foundational Pillars -->
  <section class="py-16 sm:py-24 bg-slate-50/50 dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {manifestoData.pillars.map((pillar, idx) => {
        const Icon = pillarIcons[idx] || Sparkles;
        return (
          <article 
            id={`pillar-${pillar.number}`} 
            class="p-6 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-all hover:border-slate-300 dark:hover:border-slate-700"
          >
            <!-- Pillar Header -->
            <div class="flex items-start gap-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-nostr-100 dark:bg-nostr-950 flex items-center justify-center text-nostr-600 dark:text-nostr-400 flex-shrink-0 font-mono font-bold text-lg border border-nostr-200 dark:border-nostr-800/80 shadow-sm">
                <Icon class="w-6 h-6" />
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-nostr-600 dark:text-nostr-400 font-mono">
                  Pillar {pillar.number}
                </span>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
                  {pillar.titleEn}
                </h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                  {pillar.subtitleEn}
                </p>
              </div>
            </div>

            <!-- Items within Pillar -->
            <div class="grid grid-cols-1 gap-6 pt-4 border-t border-slate-100 dark:border-slate-800/80">
              {pillar.itemsEn.map((item) => (
                <div class="space-y-1.5">
                  <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-nostr-500"></span>
                    {item.title}
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-3.5">
                    {item.body}
                  </p>
                </div>
              ))}
            </div>

          </article>
        );
      })}

      <!-- Final Callout & Conclusion -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-nostr-600 via-nostr-700 to-slate-900 text-white shadow-xl text-center space-y-6">
        <p class="text-lg sm:text-xl font-medium opacity-90">
          {manifestoData.conclusionEn.lead}
        </p>
        <blockquote class="text-2xl sm:text-4xl font-extrabold tracking-tight italic">
          "{manifestoData.conclusionEn.quote}"
        </blockquote>
        <p class="text-sm sm:text-base opacity-80 max-w-xl mx-auto">
          {manifestoData.conclusionEn.invite}
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://github.com/nostr-org-tr/nostr.org.tr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-nostr-900 bg-white hover:bg-slate-100 shadow-md transition-all active:scale-95"
          >
            <span>GitHub Repository</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="mailto:ekip@nostr.org.tr"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-all"
          >
            <Users class="w-4 h-4" />
            <span>Contact Facilitators</span>
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
