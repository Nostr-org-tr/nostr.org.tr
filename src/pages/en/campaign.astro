---
import Layout from '../../layouts/Layout.astro';
import CopyButton from '../../components/CopyButton.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { 
  HeartHandshake, 
  Sparkles, 
  ShieldCheck, 
  Zap, 
  Server, 
  GraduationCap, 
  Code2, 
  Radio, 
  Languages, 
  CheckCircle2, 
  ArrowRight, 
  Coins,
  Globe2,
  Users
} from 'lucide-astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Campaign', path: '/en/campaign' },
];

const milestones = [
  {
    step: 'Milestone 1',
    title: 'Resilient Core Infrastructure',
    target: '$5,000 / ~6.5M Sats',
    desc: '12 months of high-performance relay.nostr.org.tr dedicated NVMe server costs, nostr.org.tr domain security, and 100% Turkish localization of the top 3 Nostr clients (Amethyst, Primal, Coracle).',
  },
  {
    step: 'Milestone 2',
    title: 'Education & Community Growth',
    target: '$10,000 / ~13M Sats',
    desc: 'Comprehensive 10-episode Turkish Nostr & Lightning video masterclass, interactive onboarding hub, and 3 in-person university workshops across Istanbul and Ankara.',
  },
  {
    step: 'Milestone 3',
    title: 'Developer Grants & Hackathon',
    target: '$25,000 / ~33M Sats',
    desc: '5 open-source developer micro-grants for Turkish Nostr apps, multi-node geo-redundant relay failover cluster, and the first official Türkiye Nostr Developer Hackathon.',
  }
];

const budgetCategories = [
  {
    percent: '40%',
    title: 'Server & High-Availability Relay Infrastructure',
    color: 'bg-nostr-500 text-white',
    border: 'border-nostr-200 dark:border-nostr-800',
    icon: Server,
    items: [
      'Multi-region NVMe dedicated relay nodes (relay.nostr.org.tr)',
      'High-bandwidth WebSocket clusters and Cloudflare edge network',
      'DDoS mitigation, automated database snapshots & disaster recovery systems'
    ]
  },
  {
    percent: '25%',
    title: 'Education, Content Production & Local Outreach',
    color: 'bg-emerald-500 text-white',
    border: 'border-emerald-200 dark:border-emerald-800',
    icon: GraduationCap,
    items: [
      'Turkish video tutorials, animated explainers, and interactive onboarding guides',
      'Security checklists for beginners and university cryptographic workshops',
      'Open educational resources (OER) and localized infographics'
    ]
  },
  {
    percent: '25%',
    title: 'Open Source Dev Bounties & Tool Maintenance',
    color: 'bg-amber-500 text-white',
    border: 'border-amber-200 dark:border-amber-800',
    icon: Code2,
    items: [
      'Bounties for local NIP implementations, open-source bots, and merchant bridges',
      'Translation & localization bounties for major Nostr desktop & mobile clients',
      'Continuous maintenance and new features for nostr.org.tr web tool suites'
    ]
  },
  {
    percent: '10%',
    title: 'Domain Protection, Security Audits & Reserves',
    color: 'bg-purple-500 text-white',
    border: 'border-purple-200 dark:border-purple-800',
    icon: ShieldCheck,
    items: [
      'Multi-year domain registration & brand defense (nostr.org.tr)',
      'Independent security audits of web tools and cryptographic code',
      'Operational contingency reserve for unexpected network traffic spikes'
    ]
  }
];
---

<Layout 
  title="Nostr Türkiye Fundraising Campaign - Building Sovereign, Censorship-Resistant Infrastructure"
  description="Support Nostr Türkiye Topluluğu via Bitcoin, Lightning, or Agora to fund high-availability relays, developer grants, and open-source education for 85M+ Turkish speakers."
  isEn={true}
  ogType="article"
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbs} />
    <ArticleSchema
      title="Nostr Türkiye Fundraising Campaign"
      description="Support Nostr Türkiye Topluluğu via Bitcoin, Lightning, or Agora to fund high-availability relays, developer grants, and open-source education for 85M+ Turkish speakers."
      path="/en/campaign"
      inLanguage="en-US"
      datePublished="2025-01-01"
      dateModified="2026-09-23"
    />
  </Fragment>

  <!-- Hero Header -->
  <section class="py-12 sm:py-16 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-white via-slate-50 to-slate-100/60 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Bilingual Notice & Badge -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800 shadow-sm">
          <HeartHandshake class="w-4 h-4 text-rose-500" />
          <span>Official Community Fundraiser</span>
          <span class="text-rose-300 dark:text-rose-700">•</span>
          <span>Powered by Agora & Lightning</span>
        </div>

        <a 
          href="/kampanya" 
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-nostr-600 dark:hover:text-nostr-400 bg-white dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm transition-all"
        >
          <Languages class="w-3.5 h-3.5 text-tr-red" />
          <span>Türkçe Kampanya Sayfası</span>
          <ArrowRight class="w-3 h-3" />
        </a>
      </div>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Building Sovereign, Censorship-Resistant Communication & Community Hub
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          Empowering 85M+ Turkish speakers with open protocols, local high-speed relays (<code class="text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-nostr-600 dark:text-nostr-400 font-mono">relay.nostr.org.tr</code>), developer tooling, and decentralized digital sovereignty.
        </p>
      </div>

    </div>
  </section>

  <!-- Main Content & Sticky Campaign Widget Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Rich Campaign Details (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-12">
        
        <!-- Section 1: Background Story -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="p-2 rounded-xl bg-nostr-50 dark:bg-nostr-950 text-nostr-600 dark:text-nostr-400 border border-nostr-100 dark:border-nostr-900">
              <Sparkles class="w-5 h-5" />
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
                1. Background Story: Why Nostr Türkiye Matters
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Overcoming central censorship through sovereign public-good infrastructure</p>
            </div>
          </div>

          <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              In Türkiye and surrounding regions, digital communication is heavily constrained by corporate social media silos. Citizens, independent journalists, students, and creators regularly experience <strong>bandwidth throttling (DNS/BGP disruption)</strong>, sudden platform bans, invasive algorithmic manipulation, and arbitrary de-platforming without recourse.
            </p>
            <p>
              <strong>Nostr (Notes and Other Stuff Transmitted by Relays)</strong> liberates public communication by replacing corporate database ownership with cryptographic keypairs (<code class="text-xs font-mono bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">public key</code>) and decentralized relays. No corporation can censor your posts or delete your followers.
            </p>

            <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 space-y-3">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-500" />
                <span>What We Have Built From Scratch ($0 Outside Budget):</span>
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                <li class="flex items-start gap-2">
                  <span class="font-bold text-nostr-600 dark:text-nostr-400">•</span>
                  <span><strong>nostr.org.tr Platform:</strong> High-speed bilingual community hub powered by Astro 5, Tailwind, and Cloudflare Workers.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-bold text-nostr-600 dark:text-nostr-400">•</span>
                  <span><strong>Regional Relay (<code class="text-xs font-mono">relay.nostr.org.tr</code>):</strong> Low-latency, censorship-resilient relay hosting for regional users.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-bold text-nostr-600 dark:text-nostr-400">•</span>
                  <span><strong>Free NIP-05 Identity Resolution:</strong> Instant sovereign identity provisioning (<code class="text-xs font-mono">name@nostr.org.tr</code>) via edge API at zero cost.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-bold text-nostr-600 dark:text-nostr-400">•</span>
                  <span><strong>7+ Diagnostic Web Tools:</strong> Keypair Generator, NIP-19 Converter, NIP-05 Validator, NIP-07 Suite, Live Relay Ping, Zap Checker, and Event Signature Verifier.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-bold text-nostr-600 dark:text-nostr-400">•</span>
                  <span><strong>Education & DevFest Istanbul Keynote:</strong> Comprehensive Turkish guides and presenting <em>"Nostr: A Protocol for Freedom of Speech"</em> to tech audiences.</span>
                </li>
              </ul>
            </div>

            <p>
              To date, all hosting, domain registration, maintenance, and development hours have been funded out of pocket by volunteer maintainers. To ensure this infrastructure remains <strong>unbreakable, fast, and permanent</strong>, we invite the global Nostr & Bitcoin community to support our mission.
            </p>
          </div>
        </section>

        <!-- Section 2: Concrete Benefits -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900">
              <ShieldCheck class="w-5 h-5" />
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
                2. Tangible Benefits for Turkish Speakers & the Protocol
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Direct impact of your contribution</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
              <div class="flex items-center gap-2 text-nostr-600 dark:text-nostr-400 font-bold text-sm">
                <Radio class="w-4 h-4" />
                <span>1. Uncensorable Town Square</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                Provides a decentralized communications lifeline for journalists, students, and citizens immune to local platform blocking.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
              <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
                <Zap class="w-4 h-4" />
                <span>2. Low Latency (20-40ms)</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                Regionally hosted nodes in Istanbul and Europe reduce latency from 200ms+ down to sub-40ms for lightning-fast mobile feeds.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
              <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-sm">
                <GraduationCap class="w-4 h-4" />
                <span>3. Native Turkish Education</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                Removing language barriers through video masterclasses, client setup tutorials, and cryptographic security kits.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
              <div class="flex items-center gap-2 text-purple-600 dark:text-purple-400 font-bold text-sm">
                <Code2 class="w-4 h-4" />
                <span>4. Developer Grants & Bounties</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                Micro-grants for Turkish engineers building Nostr apps, bots, NIP standards, and Lightning payment integrations.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 3: Transparent Budget Allocation -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="p-2 rounded-xl bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 border border-amber-100 dark:border-amber-900">
              <Coins class="w-5 h-5" />
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
                3. Transparent Budget Allocation Matrix
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Every satoshi accounted for and publicly auditable</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {budgetCategories.map((cat) => {
              const Icon = cat.icon;
              return (
                <div class={`p-5 rounded-2xl bg-white dark:bg-slate-900 border ${cat.border} shadow-sm space-y-3`}>
                  <div class="flex items-center justify-between">
                    <span class={`px-2.5 py-0.5 text-xs font-extrabold rounded-lg ${cat.color}`}>
                      {cat.percent}
                    </span>
                    <Icon class="w-5 h-5 text-slate-400 opacity-80" />
                  </div>
                  <h3 class="font-bold text-sm text-slate-900 dark:text-white leading-tight">
                    {cat.title}
                  </h3>
                  <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                    {cat.items.map((item) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-slate-400">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Section 4: Milestones -->
        <section class="space-y-6">
          <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="p-2 rounded-xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400 border border-purple-100 dark:border-purple-900">
              <Users class="w-5 h-5" />
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
                4. Funding Milestones & Deliverables
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Concrete commitments unlocked at each target</p>
            </div>
          </div>

          <div class="space-y-4">
            {milestones.map((m) => (
              <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                      {m.step}
                    </span>
                    <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">
                      {m.title}
                    </h3>
                  </div>
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                    <Zap class="w-3 h-3 fill-current" />
                    <span>{m.target}</span>
                  </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                  {m.desc}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 5: Transparency & Open Source -->
        <section class="p-6 rounded-2xl bg-gradient-to-br from-nostr-50 to-purple-50 dark:from-nostr-950/40 dark:to-slate-900 border border-nostr-200 dark:border-nostr-800 space-y-3">
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Globe2 class="w-5 h-5 text-nostr-600 dark:text-nostr-400" />
            <span>Radical Transparency & Open Source Governance</span>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Our project is operated under <strong>100% open-source</strong> principles. All codebase, documentation, and tools reside publicly on GitHub. Infrastructure invoices and grant disbursements are published regularly via Nostr long-form articles (NIP-23). Any builder contributing value is welcomed as an organic decision-maker.
          </p>
        </section>

      </div>

      <!-- Right Column: Sticky Campaign Card (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-20">
        
        <!-- Agora Embed Container -->
        <div class="rounded-3xl bg-white dark:bg-slate-900 p-4 sm:p-5 border border-slate-200 dark:border-slate-800 shadow-xl space-y-4">
          <div class="flex items-center justify-between px-1">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-300">
                Live Donation Widget
              </span>
            </div>
            <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">Agora Embed</span>
          </div>

          <!-- The User Provided Iframe -->
          <div class="flex justify-center w-full overflow-hidden rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-1">
            <iframe 
              src="https://agora.spot/embed/campaign/naddr1qvzqqqyygupzq3hnc7an8npsryzfkaku38dmjm35cfrmmkngk6kcvvngy7fllzs6qqvxummnw3ez6mmjvukhgu3dve6kuerjv95hx6twvudlm2e2?variant=donate&amp;theme=light"
              width="380" 
              height="660"
              style="border:0;width:100%;max-width:380px;"
              loading="lazy" 
              allow="clipboard-write"
              referrerpolicy="no-referrer-when-downgrade"
              title="Agora fundraiser campaign"
            ></iframe>
          </div>
        </div>

        <!-- Direct Lightning Alternative Support -->
        <div class="rounded-2xl bg-white dark:bg-slate-900 p-5 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Zap class="w-4 h-4 text-amber-500 fill-amber-500" />
            <span>Direct Lightning Zap Support</span>
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            If you prefer to zap directly from your favorite mobile Lightning wallet or native Nostr client:
          </p>

          <div class="space-y-2 text-xs">
            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2">
              <div class="truncate">
                <span class="text-slate-500 block text-[10px]">Infrastructure Fund Lightning Address:</span>
                <span class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate">nostrorgtr@cake.cash</span>
              </div>
              <CopyButton text="nostrorgtr@cake.cash" label="Copy" />
            </div>

            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2">
              <div class="truncate">
                <span class="text-slate-500 block text-[10px]">Founder Maintainer Address:</span>
                <span class="font-mono font-bold text-slate-800 dark:text-slate-200 truncate">delirehberi@emre.xyz</span>
              </div>
              <CopyButton text="delirehberi@emre.xyz" label="Copy" />
            </div>
          </div>
        </div>

        <!-- Community Links Card -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-2">
          <div class="font-semibold text-slate-900 dark:text-slate-200">Institutional or Grant Inquiries:</div>
          <p>
            If you represent a foundation or sponsor wishing to provide dedicated hardware, high-bandwidth relay nodes, or grant matching, please contact us at <a href="mailto:ekip@nostr.org.tr" class="text-nostr-600 dark:text-nostr-400 font-semibold hover:underline">ekip@nostr.org.tr</a>.
          </p>
        </div>

      </div>

    </div>
  </main>
</Layout>
